include "../../lib/base.stm"
include "../../lib/testcase.stm"
include "Common/common.stm"
include "Common/interface.stm"

include "Other/other.stm"

include "TestSuites/TestSuiteSampleCaseOnlyIndex.stm"
namespace SimStmTest
proc testMainSuiteSampleCaseOnlyIndex ()

    

    verbosity stm.INFO_2
    trace stm.TRACE_OFF
    resume stm.RESUME_ON_ALL_FAILURES
    call initDut()
    signal read stm.sigInTestSuiteIndex stm.TestSuiteIndex
    log message stm.INFO "Main test main suite indexed SampleCaseOnlyIndex started"

    call testSuiteSampleCaseOnlyIndex ()

    log message stm.INFO "Main test main suite indexed SampleCaseOnlyIndex ended"
    wait 1000
    finish
end proc
end namespace