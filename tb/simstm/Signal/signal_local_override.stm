namespace SimStmTest

signal out_signal_local_override 0 

proc testSignalLocalOverride ()

    call stm.startStandardTestShell ()
    signal pointer copy out_signal_local_override loopback_1bit
    signal write out_signal_local_override 0
    wait 100
    call setSignalToOverwrite ()
    var res 100
    signal verify loopback_1bit 0 stm.MAX
    call checkSignalGlobal ()
    call stm.endStandardTestShell ()

end proc

proc setSignalToOverwrite ()
    signal out_signal_local_override 0 
    signal pointer copy out_signal_local_override loopback_32bit
    signal write out_signal_local_override 1
    wait 100
    var res 99
    signal verify out_signal_local_override 1 stm.MAX
end proc

proc checkSignalGlobal ()
    signal verify loopback_1bit 1 stm.MAX
end proc

end namespace
