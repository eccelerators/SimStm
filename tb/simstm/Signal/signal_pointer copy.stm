
-- This file tests
-- |- signal pointer copy
-- |- signal pointer get
-- |- signal pointer set

include "interface.stm"


signal internal_signal_test_1 0
signal internal_signal_test_2 0
signal internal_signal_test_3 0
signal internal_signal_test_4 0


var signal_number 0
signal temp_signal 0

proc testSignalGet ()
    -- var signal_number 0

    signal pointer get simstm_loopback_verify_passes signal_number
    var verify signal_number 10000 0xffffffff
    signal pointer get simstm_loopback_verify_failures signal_number
    var verify signal_number 10001 0xffffffff
    signal pointer get simstm_loopback_bus_timeout_passes signal_number
    var verify signal_number 10002 0xffffffff
    signal pointer get simstm_loopback_bus_timeout_failures signal_number
    var verify signal_number 10003 0xffffffff


    signal pointer get loopback_1bit signal_number
    var verify signal_number 11000 0xffffffff
    signal pointer get loopback_32bit signal_number
    var verify signal_number 11001 0xffffffff
    signal pointer get loopback_16bit_cross signal_number
    var verify signal_number 11002 0xffffffff

end proc


proc testSignalSet ()
    signal pointer set temp_signal 11000  -- loopback_1bit
    signal write temp_signal 0
    signal verify temp_signal val_signal_read_back 0 0xffffffff
    signal write temp_signal 0xffffffff
    signal verify temp_signal val_signal_read_back 1 0xffffffff

    signal pointer set temp_signal 11001  -- loopback_32bit
    signal write temp_signal 0
    signal verify temp_signal val_signal_read_back 0 0xffffffff
    signal write temp_signal 0xffffffff
    signal verify temp_signal val_signal_read_back 0xffffffff 0xffffffff

    signal pointer set temp_signal 11002  -- loopback_16bit_cross
    signal write temp_signal 0
    signal verify temp_signal val_signal_read_back 0 0xffffffff
    signal write temp_signal 0xffffffff
    signal verify temp_signal val_signal_read_back 0x84C2 0xffffffff
end proc




proc testSignalPointer ()
    signal pointer copy temp_signal loopback_1bit
    signal write temp_signal 0
    signal verify temp_signal val_signal_read_back 0 0xffffffff
    signal write temp_signal 0xffffffff
    signal verify temp_signal val_signal_read_back 1 0xffffffff

    signal pointer copy temp_signal loopback_32bit
    signal write temp_signal 0
    signal verify temp_signal val_signal_read_back 0 0xffffffff
    signal write temp_signal 0xffffffff
    signal verify temp_signal val_signal_read_back 0xffffffff 0xffffffff

    signal pointer copy temp_signal loopback_16bit_cross
    signal write temp_signal 0
    signal verify temp_signal val_signal_read_back 0 0xffffffff
    signal write temp_signal 0xffffffff
    signal verify temp_signal val_signal_read_back 0x84C2 0xffffffff
end proc
