    proc testSignalVerifyVarVar ()
        call stm.startStandardTestShell ()
        call unitSignalVerifyVarVar ()
        call stm.endStandardTestShell ()    
    end proc

    -- expected=var / mask=var
    proc unitSignalVerifyVarVar ()
        var read_back    0x12345678
        var expected_val 0
        var mask_val     0
        var write_val    0

        equ write_val    0xdeadbeef
        equ expected_val 0xdeadbeef
        equ mask_val     0xffffffff

        signal write  loopback_32bit write_val
        wait 1000
        signal read   loopback_32bit read_back
        var    verify read_back      expected_val mask_val
        signal verify loopback_32bit expected_val mask_val

        equ expected_val 0x82204101
        equ mask_val     0xaaaa5555
        signal write  loopback_32bit 0x87654321
        wait 1000
        signal read   loopback_32bit read_back
        signal verify loopback_32bit expected_val mask_val

        equ expected_val 2183151873
        equ mask_val     0b10101010101010100101010101010101
        signal verify loopback_32bit expected_val mask_val

        equ expected_val 0b10000010001000000100000100000001
        equ mask_val     2863289685
        signal verify loopback_32bit expected_val mask_val
    end proc

