    -- expected=bin / mask=var
    proc unitSignalVerifyBinVar ()
        var read_back    0x12345678
        var expected_val 0
        var mask_val     0
        var write_val    0

        equ write_val 0b11001010111111100001001000110100
        equ mask_val  0b11111111111111111111111111111111

        signal write  loopback_32bit write_val
        wait 1000
        signal read   loopback_32bit read_back
        var    verify read_back      0b11001010111111100001001000110100 mask_val
        signal verify loopback_32bit 0b11001010111111100001001000110100 mask_val

        equ mask_val  0b10101010101010100101010101010101
        signal write  loopback_32bit 0x87654321
        wait 1000
        signal read   loopback_32bit read_back
        var    verify read_back      0b10000111011001010100001100100001 0b11111111111111111111111111111111
