-- This file tests
-- |- signal verify with mixed value formats (dec, hex, bin) for expected and mask
-- |- combinations: dec/dec, hex/hex, bin/bin, dec/hex, dec/bin, hex/dec, hex/bin, bin/dec, bin/hex
-- |- combinations: var/dec, var/hex, var/bin, dec/var, hex/var, bin/var, var/var


include "interface.stm"

namespace SimStmTest

    proc testSignalExtend ()
        call testSignalVerifyDecDec()
        call testSignalVerifyHexHex()
        call testSignalVerifyBinBin()
        call testSignalVerifyDecHex()
        call testSignalVerifyDecBin()
        call testSignalVerifyHexDec()
        call testSignalVerifyHexBin()
        call testSignalVerifyBinDec()
        call testSignalVerifyBinHex()
        call testSignalVerifyVarDec()
        call testSignalVerifyVarHex()
        call testSignalVerifyVarBin()
        call testSignalVerifyDecVar()
        call testSignalVerifyHexVar()
        call testSignalVerifyBinVar()
        call testSignalVerifyVarVar()
    end proc


    -- write 0 then verify expected=dec / mask=dec
    proc testSignalVerifyDecDec ()
        var read_back    0x12345678
        var expected_val 0
        var mask_val     0
        var write_val    0

        equ write_val    0xdeadbeef

        signal write  loopback_32bit write_val
        wait 1000
        signal read   loopback_32bit read_back
        var    verify read_back      3735928559 4294967295
        signal verify loopback_32bit 3735928559 4294967295

        signal write  loopback_32bit 2271560481
        wait 1000
        signal read   loopback_32bit read_back
        var    verify read_back      2271560481 4294967295
        signal verify loopback_32bit 2271560481 4294967295
        signal verify loopback_32bit 2183151873 2863289685
    end proc

    -- write 0 then verify expected=hex / mask=hex
    proc testSignalVerifyHexHex ()
        var read_back    0x12345678
        var expected_val 0
        var mask_val     0
        var write_val    0

        equ write_val    0xdeadbeef

        signal write  loopback_32bit write_val
        wait 1000
        signal read   loopback_32bit read_back
        var    verify read_back      0xdeadbeef 0xffffffff
        signal verify loopback_32bit 0xdeadbeef 0xffffffff

        signal write  loopback_32bit 0x87654321
        wait 1000
        signal read   loopback_32bit read_back
        var    verify read_back      0x87654321 0xffffffff
        signal verify loopback_32bit 0x87654321 0xffffffff
        signal verify loopback_32bit 0x82204101 0xaaaa5555
    end proc

    -- write 0 then verify expected=bin / mask=bin
    proc testSignalVerifyBinBin ()
        var read_back    0x12345678
        var expected_val 0
        var mask_val     0
        var write_val    0

        equ write_val    0b11011110101011011011111011101111

        signal write  loopback_32bit write_val
        wait 1000
        signal read   loopback_32bit read_back
        var    verify read_back      0b11011110101011011011111011101111 0b11111111111111111111111111111111
        signal verify loopback_32bit 0b11011110101011011011111011101111 0b11111111111111111111111111111111

        signal write  loopback_32bit 0b10000111011001010100001100100001
        wait 1000
        signal read   loopback_32bit read_back
        var    verify read_back      0b10000111011001010100001100100001 0b11111111111111111111111111111111
        signal verify loopback_32bit 0b10000111011001010100001100100001 0b11111111111111111111111111111111
        signal verify loopback_32bit 0b10000010001000000100000100000001 0b10101010101010100101010101010101
    end proc

    -- expected=dec / mask=hex
    proc testSignalVerifyDecHex ()
        var read_back    0x12345678
        var expected_val 0
        var mask_val     0
        var write_val    0

        equ write_val    0xc0fffe00

        signal write  loopback_32bit write_val
        wait 1000
        signal read   loopback_32bit read_back
        var    verify read_back      3238002176 0xffffffff
        signal verify loopback_32bit 3238002176 0xffffffff

        signal write  loopback_32bit 0x87654321
        wait 1000
        signal read   loopback_32bit read_back
        var    verify read_back      2271560481 0xffffffff
        signal verify loopback_32bit 2271560481 0xffffffff
        signal verify loopback_32bit 2183151873 0xaaaa5555
    end proc

    -- expected=dec / mask=bin
    proc testSignalVerifyDecBin ()
        var read_back    0x12345678
        var expected_val 0
        var mask_val     0
        var write_val    0

        equ write_val    0xabcd1234

        signal write  loopback_32bit write_val
        wait 1000
        signal read   loopback_32bit read_back
        var    verify read_back      2882343476 0b11111111111111111111111111111111
        signal verify loopback_32bit 2882343476 0b11111111111111111111111111111111

        signal write  loopback_32bit 0x87654321
        wait 1000
        signal read   loopback_32bit read_back
        var    verify read_back      2271560481 0b11111111111111111111111111111111
        signal verify loopback_32bit 2271560481 0b11111111111111111111111111111111
        signal verify loopback_32bit 2183151873 0b10101010101010100101010101010101
    end proc

    -- expected=hex / mask=dec
    proc testSignalVerifyHexDec ()
        var read_back    0x12345678
        var expected_val 0
        var mask_val     0
        var write_val    0

        equ write_val    0xfeedface

        signal write  loopback_32bit write_val
        wait 1000
        signal read   loopback_32bit read_back
        var    verify read_back      0xfeedface 4294967295
        signal verify loopback_32bit 0xfeedface 4294967295

        signal write  loopback_32bit 0x87654321
        wait 1000
        signal read   loopback_32bit read_back
        var    verify read_back      0x87654321 4294967295
        signal verify loopback_32bit 0x87654321 4294967295
        signal verify loopback_32bit 0x82204101 2863289685
    end proc

    -- expected=hex / mask=bin
    proc testSignalVerifyHexBin ()
        var read_back    0x12345678
        var expected_val 0
        var mask_val     0
        var write_val    0

        equ write_val    0xbabe0000

        signal write  loopback_32bit write_val
        wait 1000
        signal read   loopback_32bit read_back
        var    verify read_back      0xbabe0000 0b11111111111111111111111111111111
        signal verify loopback_32bit 0xbabe0000 0b11111111111111111111111111111111

