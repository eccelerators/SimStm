
namespace SimStmTest

proc testSignalVerifyFail ()
    call stm.startStandardTestShell ()
    call unitSignalVerifyFail ()
    call stm.endStandardTestShell ()    
end proc

proc unitSignalVerifyFail ()
    var val_signal_read_back 0x12345678

    signal write  loopback_32bit 0
    wait 1000
    signal read   loopback_32bit val_signal_read_back

    resume 1
    -- this will end with an failure
    signal verify loopback_32bit 0x12345678 0xffffffff
    resume 0

    call increase_verify_failure_counter ()
    call check_verify_failures ()
end proc

    var failure_expected_counter 0
    proc increase_verify_failure_counter (
        var steps 1
    )
        add          failure_expected_counter                steps
        signal write simstm_loopback_verify_failure_expected failure_expected_counter
    end proc

    proc check_verify_failures ()
        signal verify simstm_loopback_verify_failures failure_expected_counter 0xffffffff
    end proc


    var bus_timeout_failure_expected_counter 0
    proc increase_bus_timeout_failure_counter (
        var steps 1
    )
        add          bus_timeout_failure_expected_counter         steps
        signal write simstm_loopback_bus_timeout_failure_expected bus_timeout_failure_expected_counter
    end proc

    proc check_bus_timeout_failures ()
        signal verify simstm_loopback_bus_timeout_failures bus_timeout_failure_expected_counter 0xffffffff
    end proc

end namespace