namespace SimStmTest

array file_array 8
array another_array 8

var number_of_elements_got 0
var number_of_lines 0
var index_of_line 0
var index_of_line_offset 0
var lines_size 0

lines a_lines_aa

proc testLinesAppendArray ()

    call stm.startStandardTestShell ()

    array set file_array 0 0
    array set file_array 1 1
    array set file_array 2 0xA
    array set file_array 3 2
    array set file_array 4 0xB
    array set file_array 5 0x7FFFFFFF
    array set file_array 6 0x80000000
    array set file_array 7 0xFFFFFFFF
    lines append array a_lines_aa file_array

    array set file_array 0 1
    lines append array a_lines_aa file_array

    array set file_array 0 2
    lines append array a_lines_aa file_array

    log lines 0 a_lines_aa

    lines size a_lines_aa number_of_lines
    var verify number_of_lines 3 stm.MAX

    call stm.endStandardTestShell ()
end proc

lines a_lines_at

proc testLinesAppendText ()

     call stm.startStandardTestShell ()

    lines append message a_lines_at "line 1"
    lines append message a_lines_at "line 2"
    lines append message a_lines_at "line 3"

    log lines 0 a_lines_at

    lines size a_lines_at number_of_lines
    var verify number_of_lines 3 stm.MAX

    call stm.endStandardTestShell ()
end proc

lines a_lines_daa

proc testLinesDeleteAllArray ()

    call stm.startStandardTestShell ()

    array set file_array 0 0
    array set file_array 1 1
    array set file_array 2 0xA
    array set file_array 3 2
    array set file_array 4 0xB
    array set file_array 5 0x7FFFFFFF
    array set file_array 6 0x80000000
    array set file_array 7 0xFFFFFFFF
    lines append array a_lines_daa file_array

    array set file_array 0 1
    lines append array a_lines_daa file_array

    array set file_array 0 2
    lines append array a_lines_daa file_array

    log lines 0 a_lines_daa

    lines size a_lines_daa number_of_lines
    var verify number_of_lines 3 stm.MAX

    lines delete all a_lines_daa
    log lines 0 a_lines_daa

    lines size a_lines_daa number_of_lines
    var verify number_of_lines 0 stm.MAX

    call stm.endStandardTestShell ()
end proc

lines a_lines_da

proc testLinesDeleteArray ()

    call stm.startStandardTestShell ()

    array set file_array 0 0
    array set file_array 1 1
    array set file_array 2 0xA
    array set file_array 3 2
    array set file_array 4 0xB
    array set file_array 5 0x7FFFFFFF
    array set file_array 6 0x80000000
    array set file_array 7 0xFFFFFFFF
    lines append array a_lines_da file_array

    array set file_array 0 1
    lines append array a_lines_da file_array

    array set file_array 0 2
    lines append array a_lines_da file_array

    log lines 0 a_lines_da

    lines size a_lines_da number_of_lines
    var verify number_of_lines 3 stm.MAX

    lines delete a_lines_da 1
    log lines 0 a_lines_da

    lines size a_lines_da number_of_lines
    var verify number_of_lines 2 stm.MAX

    lines delete a_lines_da 1
    log lines 0 a_lines_da

    lines size a_lines_da number_of_lines
    var verify number_of_lines 1 stm.MAX

    lines delete a_lines_da 0
    log lines 0 a_lines_da

    lines size a_lines_da number_of_lines
    var verify number_of_lines 0 stm.MAX

    call stm.endStandardTestShell ()
end proc

lines a_lines_ga

proc testLinesGetArray ()

    call stm.startStandardTestShell ()

    array set file_array 0 0
    array set file_array 1 1
    array set file_array 2 0xA
    array set file_array 3 2
    array set file_array 4 0xB
    array set file_array 5 0x7FFFFFFF
    array set file_array 6 0x80000000
    array set file_array 7 0xFFFFFFFF

    lines append array a_lines_ga file_array
    log lines 0 a_lines_ga

    array set file_array 0 1
    lines append array a_lines_ga file_array
    log lines 0 a_lines_ga

    array set file_array 0 2
    lines append array a_lines_ga file_array
    log lines 0 a_lines_ga

    lines size a_lines_ga number_of_lines
    var verify number_of_lines 3 stm.MAX

    equ index_of_line 0
    loop number_of_lines
        lines get array a_lines_ga index_of_line another_array number_of_elements_got
        log message 0 "number_of_elements_got {}" number_of_elements_got
        
        call arrayDump (
        	array pointer copy Array another_array
        )
        array verify another_array 0 index_of_line stm.MAX
        array verify another_array 1 1 stm.MAX
        array verify another_array 2 0xA stm.MAX
        array verify another_array 3 2 stm.MAX
        array verify another_array 4 0xB stm.MAX
        array verify another_array 5 0x7FFFFFFF stm.MAX
        array verify another_array 6 0x80000000 stm.MAX
        array verify another_array 7 0xFFFFFFFF stm.MAX
        add index_of_line 1
    end loop

    call stm.endStandardTestShell ()
end proc

lines a_lines_ia

proc testLinesInsertArray ()

    call stm.startStandardTestShell ()

    array set file_array 0 0
    array set file_array 1 1
    array set file_array 2 0xA
    array set file_array 3 2
    array set file_array 4 0xB
    array set file_array 5 0x7FFFFFFF
    array set file_array 6 0x80000000

    array set file_array 7 0xFFFFFFFF

    lines append array a_lines_ia file_array
    log lines 0 a_lines_ia

    array set file_array 0 1
    lines append array a_lines_ia file_array
    log lines 0 a_lines_ia

    array set file_array 0 2
    lines append array a_lines_ia file_array

    log lines 0 a_lines_ia

    lines size a_lines_ia number_of_lines
    var verify number_of_lines 3 stm.MAX

    equ index_of_line 0
    loop number_of_lines
        lines get array a_lines_ia index_of_line another_array number_of_elements_got
        log message 0 "number_of_elements_got {}" number_of_elements_got
        call arrayDump (
        	array pointer copy Array another_array
        )
        array verify another_array 0 index_of_line stm.MAX
        array verify another_array 1 1 stm.MAX
        array verify another_array 2 0xA stm.MAX
        array verify another_array 3 2 stm.MAX
        array verify another_array 4 0xB stm.MAX
        array verify another_array 5 0x7FFFFFFF stm.MAX
        array verify another_array 6 0x80000000 stm.MAX
        array verify another_array 7 0xFFFFFFFF stm.MAX
        add index_of_line 1
    end loop

    array set file_array 0 3
    array set file_array 1 0x22
    array set file_array 2 0x33
    array set file_array 3 0
    array set file_array 4 0x12345678
    array set file_array 5 0x777
    array set file_array 6 0x800
    array set file_array 7 0xFFF
    lines insert array a_lines_ia 1 file_array
    log lines 0 a_lines_ia

    array set file_array 0 4
    lines insert array a_lines_ia 0 file_array

    array set file_array 0 5
    lines insert array a_lines_ia 4 file_array

    log message 0 "6"
    log lines 0 a_lines_ia

    lines size a_lines_ia number_of_lines
    var verify number_of_lines 6 stm.MAX

    equ index_of_line 1
    equ index_of_line_offset 0
    loop 3
        lines get array a_lines_ia index_of_line another_array number_of_elements_got
        log message 0 "number_of_elements_got {}" number_of_elements_got
        call arrayDump (
        	array pointer copy Array another_array
        )
        array verify another_array 0 index_of_line_offset stm.MAX
        array verify another_array 1 1 stm.MAX
        array verify another_array 2 0xA stm.MAX
        array verify another_array 3 2 stm.MAX
        array verify another_array 4 0xB stm.MAX
        array verify another_array 5 0x7FFFFFFF stm.MAX
        array verify another_array 6 0x80000000 stm.MAX
        array verify another_array 7 0xFFFFFFFF stm.MAX
        add index_of_line 2
        add index_of_line_offset 1
    end loop

       equ index_of_line 0
       equ index_of_line_offset 4
    loop 3
        lines get array a_lines_ia index_of_line another_array number_of_elements_got
        log message 0 "number_of_elements_got {}" number_of_elements_got
        call arrayDump (
        	array pointer copy Array another_array
        )
        array verify another_array 0 index_of_line_offset stm.MAX
        array verify another_array 1 0x22 stm.MAX
        array verify another_array 2 0x33 stm.MAX
        array verify another_array 3 0 stm.MAX
        array verify another_array 4 0x12345678 stm.MAX
        array verify another_array 5 0x777 stm.MAX
        array verify another_array 6 0x800 stm.MAX
        array verify another_array 7 0xFFF stm.MAX
        add index_of_line 2
        if index_of_line_offset = 4
            equ index_of_line_offset 3
        elsif index_of_line_offset = 3
            equ index_of_line_offset 5
        end if
    end loop

    call stm.endStandardTestShell ()
end proc

lines a_lines_it

proc testLinesInsertText ()

    call stm.startStandardTestShell ()

    lines append message a_lines_it "line 0"
    lines append message a_lines_it "line 1"
    lines append message a_lines_it "line 2"

    log lines 0 a_lines_it

    lines size a_lines_it number_of_lines
    var verify number_of_lines 3 stm.MAX

    lines insert message a_lines_it 0 "line insert 1"
    log lines 0 a_lines_it
    lines size a_lines_it number_of_lines
    var verify number_of_lines 4 stm.MAX

    lines insert message a_lines_it 1 "line insert 0"
    log lines 0 a_lines_it
    lines size a_lines_it number_of_lines
    var verify number_of_lines 5 stm.MAX

    lines insert message a_lines_it 4 "line insert 4"
    log lines 0 a_lines_it
    lines size a_lines_it number_of_lines
    var verify number_of_lines 6 stm.MAX

    call stm.endStandardTestShell ()
end proc

lines a_lines_pc
lines b_lines_pc

proc testLinesPointerCopy ()

    call stm.startStandardTestShell ()

    array set file_array 0 0
    array set file_array 1 1
    array set file_array 2 0xA
    array set file_array 3 2
    array set file_array 4 0xB
    array set file_array 5 0x7FFFFFFF
    array set file_array 6 0x80000000
    array set file_array 7 0xFFFFFFFF
    lines append array a_lines_pc file_array

    array set file_array 0 1
    lines append array a_lines_pc file_array

    array set file_array 0 2
    lines append array a_lines_pc file_array

    log lines 0 a_lines_pc
    log lines 0 b_lines_pc

    lines size a_lines_pc number_of_lines
    var verify number_of_lines 3 stm.MAX
    lines size b_lines_pc number_of_lines
    var verify number_of_lines 0 stm.MAX

    lines pointer copy b_lines_pc a_lines_pc
    log lines 0 a_lines_pc
    log lines 0 b_lines_pc

    lines size a_lines_pc number_of_lines
    var verify number_of_lines 3 stm.MAX
    lines size b_lines_pc number_of_lines
    var verify number_of_lines 3 stm.MAX

    array set file_array 0 0xAFAFAFEE
    lines append array b_lines_pc file_array
    log lines 0 a_lines_pc
    log lines 0 b_lines_pc


    lines size a_lines_pc number_of_lines
    var verify number_of_lines 4 stm.MAX
    lines size b_lines_pc number_of_lines
    var verify number_of_lines 4 stm.MAX

    call stm.endStandardTestShell ()
end proc

lines a_lines_sa

proc testLinesSetArray ()

    call stm.startStandardTestShell ()

    array set file_array 0 0
    array set file_array 1 1
    array set file_array 2 0xA
    array set file_array 3 2
    array set file_array 4 0xB
    array set file_array 5 0x7FFFFFFF
    array set file_array 6 0x80000000
    -- trace  0x7
    array set file_array 7 0xFFFFFFFF

    lines append array a_lines_sa file_array
    log lines 0 a_lines_sa

    array set file_array 0 1
    lines append array a_lines_sa file_array
    log lines 0 a_lines_sa

    array set file_array 0 2
    lines append array a_lines_sa file_array

    log lines 0 a_lines_sa

    lines size a_lines_sa number_of_lines
    var verify number_of_lines 3 stm.MAX

    equ index_of_line 0
    loop number_of_lines
        lines get array a_lines_sa index_of_line another_array number_of_elements_got
        log message 0 "number_of_elements_got {}" number_of_elements_got
        call arrayDump (
        	array pointer copy Array another_array
        )
        array verify another_array 0 index_of_line stm.MAX
        array verify another_array 1 1 stm.MAX
        array verify another_array 2 0xA stm.MAX
        array verify another_array 3 2 stm.MAX
        array verify another_array 4 0xB stm.MAX
        array verify another_array 5 0x7FFFFFFF stm.MAX
        array verify another_array 6 0x80000000 stm.MAX
        array verify another_array 7 0xFFFFFFFF stm.MAX
        add index_of_line 1
    end loop

    array set file_array 0 3
    array set file_array 1 0x22
    array set file_array 2 0x33
    array set file_array 3 0
    array set file_array 4 0x12345678
    array set file_array 5 0x777
    array set file_array 6 0x800
    array set file_array 7 0xFFF
    lines set array a_lines_sa 1 file_array
    log lines 0 a_lines_sa

    equ index_of_line 0
    loop number_of_lines
        lines get array a_lines_sa index_of_line another_array number_of_elements_got
        log message 0 "number_of_elements_got {}" number_of_elements_got
        call arrayDump (
        	array pointer copy Array another_array
        )
        add index_of_line 1
    end loop

    lines size a_lines_sa number_of_lines
    var verify number_of_lines 3 stm.MAX

    equ index_of_line 0
    loop number_of_lines
        lines get array a_lines_sa index_of_line another_array number_of_elements_got
        log message 0 "number_of_elements_got {}" number_of_elements_got
        call arrayDump (
        	array pointer copy Array another_array
        )
        if index_of_line = 1
            array verify another_array 0 3 stm.MAX
            array verify another_array 1 0x22 stm.MAX
            array verify another_array 2 0x33 stm.MAX
            array verify another_array 3 0 stm.MAX
            array verify another_array 4 0x12345678 stm.MAX
            array verify another_array 5 0x777 stm.MAX
            array verify another_array 6 0x800 stm.MAX
            array verify another_array 7 0xFFF stm.MAX
        else
            array verify another_array 0 index_of_line stm.MAX
            array verify another_array 1 1 stm.MAX
            array verify another_array 2 0xA stm.MAX
            array verify another_array 3 2 stm.MAX
            array verify another_array 4 0xB stm.MAX
            array verify another_array 5 0x7FFFFFFF stm.MAX
            array verify another_array 6 0x80000000 stm.MAX
            array verify another_array 7 0xFFFFFFFF stm.MAX
        end if
        add index_of_line 1
    end loop

    call stm.endStandardTestShell ()
end proc

lines a_lines_st

proc testLinesSetText ()

    call stm.startStandardTestShell ()

    lines append message a_lines_st "line 1"
    lines append message a_lines_st "line 2"
    lines append message a_lines_st "line 3"

    log lines 0 a_lines_st

    lines size a_lines_st number_of_lines
    var verify number_of_lines 3 stm.MAX

    lines set message a_lines_st 0 "line set 1"
    lines set message a_lines_st 1 "line set 2"
    lines set message a_lines_st 2 "line set 3"

    log lines 0 a_lines_st

    lines size a_lines_st number_of_lines
    var verify number_of_lines 3 stm.MAX

    call stm.endStandardTestShell ()
end proc

lines a_lines_ls

proc testLinesSize ()

    call stm.startStandardTestShell ()

    array set file_array 0 0
    array set file_array 1 1
    array set file_array 2 0xA
    array set file_array 3 2
    array set file_array 4 0xB
    array set file_array 5 0x7FFFFFFF
    array set file_array 6 0x80000000
    array set file_array 7 0xFFFFFFFF
    lines append array a_lines_ls file_array
    lines size a_lines_ls number_of_lines
    var verify number_of_lines 1 stm.MAX

    array set file_array 0 1
    lines append array a_lines_ls file_array
    lines size a_lines_ls number_of_lines
    var verify number_of_lines 2 stm.MAX

    array set file_array 0 2
    lines append array a_lines_ls file_array
    lines size a_lines_ls number_of_lines
    var verify number_of_lines 3 stm.MAX

    log lines 0 a_lines_ls

    lines size a_lines_ls lines_size

    log message 0 "lines size is {}" lines_size

    call stm.endStandardTestShell ()
end proc

end namespace
