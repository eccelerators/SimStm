include "../../lib/base.stm"
include "../../lib/testcase.stm"
include "Common/common.stm"
include "Common/interface.stm"

include "Basic/basic.stm"

include "TestSuites/TestSuiteBasic.stm"
namespace SimStmTest
proc testMainSuiteBasic ()

    

    verbosity stm.INFO_2
    trace stm.TRACE_OFF
    resume stm.RESUME_ON_ALL_FAILURES
    call initDut()
    log message stm.INFO "Main test suite Basic started"

    call testSuiteBasic ()

    log message stm.INFO "Main test suite Basic ended"
    wait 1000
    finish
end proc
end namespace
