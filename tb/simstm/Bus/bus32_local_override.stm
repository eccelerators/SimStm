
bus a_bus 0

proc testBusLocalOverride ()
	
	call startStandardTestShell ()
	bus pointer copy a_bus wishbone32 
	bus write a_bus 32 0 2
	wait 100
	call setBusToOverwrite ()
	var res 99
	bus verify a_bus 32 0 res 2 MAX
	call checkBusGlobal ()
	call endStandardTestShell ()
	
end proc



proc setBusToOverwrite ()

	bus a_bus 0
	bus pointer copy a_bus avalon32
	bus write a_bus 32 0 1
	wait 100
	var res 99
	bus verify a_bus 32 0 res 1 MAX
end proc

proc checkBusGlobal ()

	var global_res 99
	bus verify a_bus 32 0 global_res 2 MAX
end proc