include "../../lib/base.stm"
include "../../lib/testcase.stm"
include "Common/common.stm"
include "Common/interface.stm"

include "Variable/variable.stm"
include "Variable/variable_local.stm"
include "Variable/variable_pointer.stm"
include "Variable/variable_parameter.stm"
include "Variable/variable_local_override.stm"
include "Variable/variable_default_value.stm"

include "TestSuites/TestSuiteVariable.stm"
namespace SimStmTest
proc testMainSuiteVariable ()

    

    verbosity stm.INFO_2
    trace stm.TRACE_OFF
    resume stm.RESUME_ON_ALL_FAILURES
    call initDut()
    log message stm.INFO "Main test suite Variable started"

    call testSuiteVariable ()

    log message stm.INFO "Main test suite Variable ended"
    wait 1000
    finish
end proc

end namespace