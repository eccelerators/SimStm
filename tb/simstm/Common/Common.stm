include "../../lib/Base.stm"
include "TestCase/TestCase.stm"

namespace SimStmTest

const NO_BUS 0
bus wishbone32 1
bus wishbone64 2
bus wishbone128 3
bus wishbone256 4
bus avalon32 5
bus avalon64 6
bus axi4lite32 7
bus ram32 8

proc logBusToTest (
	bus busToTest NO_BUS
)
    var valBusToTest 0
    bus pointer get busToTest valBusToTest
    if valBusToTest = 1
        log message stm.ALWAYS "Testing bus({:d}) NONE with machine value width {:d}" valBusToTest stm.MachineValueWidth
    elsif valBusToTest = 1
        log message stm.ALWAYS "Testing bus({:d}) wishbone32 with machine value width {:d}" valBusToTest stm.MachineValueWidth
    elsif valBusToTest = 2
        log message stm.ALWAYS "Testing bus({:d}) wishbone64 with machine value width {:d}" valBusToTest stm.MachineValueWidth
    elsif valBusToTest = 3
        log message stm.ALWAYS "Testing bus({:d}) wishbone128 with machine value width {:d}" valBusToTest stm.MachineValueWidth
    elsif valBusToTest = 4
        log message stm.ALWAYS "Testing bus({:d}) wishbone256 with machine value width {:d}" valBusToTest stm.MachineValueWidth
    elsif valBusToTest = 5
        log message stm.ALWAYS "Testing bus({:d}) avalon32 with machine value width {:d}" valBusToTest stm.MachineValueWidth
    elsif valBusToTest = 6
        log message stm.ALWAYS "Testing bus({:d}) avalon64 with machine value width {:d}" valBusToTest stm.MachineValueWidth
    elsif valBusToTest = 7
        log message stm.ALWAYS "Testing bus({:d}) axi4lite32 with machine value width {:d}" valBusToTest stm.MachineValueWidth
    elsif valBusToTest = 8
        log message stm.ALWAYS "Testing bus({:d}) ram32 with machine value width {:d}" valBusToTest stm.MachineValueWidth
    else
        log message stm.ALWAYS "Testing bus({:d}) unknown with machine value width {:d}" valBusToTest stm.MachineValueWidth
    end if
end proc

var WaitTimeOut 100000 -- ms

const NO_SIGNAL 0

signal out_signal_init_dut 1

signal out_signal_interrupt_a 1000
signal out_signal_interrupt_b 1001

signal in_signal_2000 2000
signal in_signal_2001 2001
signal in_signal_2002 2002
signal in_signal_2003 2003

signal out_signal_3000 3000
signal out_signal_3001 3001
signal out_signal_3002 3002
signal out_signal_3003 3003

end namespace

