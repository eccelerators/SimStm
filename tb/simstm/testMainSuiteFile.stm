include "../../lib/base.stm"
include "../../lib/testcase.stm"
include "Common/common.stm"
include "Common/interface.stm"

include "File/file.stm"
include "Base/Array.stm"
include "TestSuites/TestSuiteFile.stm"

include "File/file_local_override.stm"
include "File/file_local.stm"
include "File/file_parameter.stm"
include "File/file_pointer.stm"
namespace SimStmTest
proc testMainSuiteFile ()

    

    verbosity stm.INFO_2
    trace stm.TRACE_OFF
    resume stm.RESUME_ON_ALL_FAILURES
    call initDut()
    log message stm.INFO "Main test suite File started"

    call testSuiteFile ()

    log message stm.INFO "Main test suite File ended"
    wait 1000
    finish
end proc

end namespace