include "../../lib/base.stm"
include "../../lib/testcase.stm"
include "Common/common.stm"
include "Common/interface.stm"

include "Array/array.stm"
include "Array/array_size.stm"
include "Array/array_pointer.stm"

include "Array/array_default_value.stm"
include "Array/array_local_override.stm"
include "Array/array_local.stm"
include "Array/array_parameter.stm"

include "TestSuites/TestSuiteArray.stm"

namespace SimStmTest

proc testMainSuiteArray ()

    verbosity stm.INFO_2
    trace stm.TRACE_OFF
    resume stm.RESUME_ON_ALL_FAILURES
    call initDut()
    log message stm.INFO "Main test suite Array started"

    call testSuiteArray ()

    log message stm.INFO "Main test suite Array ended"
    wait 1000
    finish
end proc
end namespace