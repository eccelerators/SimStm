include "../../lib/base.stm"
include "../../lib/testcase.stm"
include "Common/common.stm"
include "Common/interface.stm"

include "Base/Array.stm"

include "Lines/lines.stm"
include "Lines/lines_local.stm"
include "Lines/lines_parameter.stm"
include "Lines/lines_pointer.stm"
include "Lines/lines_local_override.stm"

include "TestSuites/TestSuiteLines.stm"
namespace SimStmTest
proc testMainSuiteLines ()

    

    verbosity stm.INFO_2
    trace stm.TRACE_OFF
    resume stm.RESUME_ON_ALL_FAILURES
    call initDut()
    log message stm.INFO "Main test suite Lines started"

    call testSuiteLines ()

    log message stm.INFO "Main test suite Lines ended"
    wait 1000
    finish
end proc
end namespace
