namespace SimStmTest

proc testSuiteArray ()

    call stm.testCase (
    	label set TestToCall testArray
    )
    
    call stm.testCase (
        label set TestToCall testArrayGet
    )
    
    call stm.testCase (
    	label set TestToCall testArraySet
    )

    call stm.testCase (
    	label set TestToCall testArraySize
    )

    call stm.testCase (
    	label set TestToCall testArrayPointerCopy
    )

    call stm.testCase (
    	label set TestToCall testArrayParameterIn
    )

    call stm.testCase (
    	label set TestToCall testArrayParameterOut
    )

    call stm.testCase (
    	label set TestToCall testArrayLocal
    )

    call stm.testCase (
    	label set TestToCall testArrayLocalOverride
    )

    call stm.testCase (
    	label set TestToCall testArrayDefaultValue
    )

end proc

end namespace