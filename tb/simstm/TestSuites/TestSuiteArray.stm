
proc testSuiteArray ()

    call testCase (
    	label set TestToCall testArray
    )
    
    call testCase (
        label set TestToCall testArrayGet
    )
    
    label lblTestCaseArraySet testArraySet
    call testCase (
    	label pointer copy TestToCall lblTestCaseArraySet
    )
    
    label lblTestCaseArraySize testArraySize
    call testCase (
    	label pointer copy TestToCall lblTestCaseArraySize
    )
    
    label lblTestCaseArrayPointerCopy testArrayPointerCopy
    call testCase (
    	label pointer copy TestToCall lblTestCaseArrayPointerCopy
    )
    
    label lblTestCaseArrayParameterIn testArrayParameterIn
    call testCase (
    	label pointer copy TestToCall lblTestCaseArrayParameterIn
    )
    
    label lblTestCaseArrayParameterOut testArrayParameterout
    call testCase (
    	label pointer copy TestToCall lblTestCaseArrayParameterOut
    )
    
    label lblTestCaseArrayLocal testArrayLocal
    call testCase (
    	label pointer copy TestToCall lblTestCaseLocal
    )
    
    label lblTestCaseArrayLocalOverride testArrayLocalOverride
    call testCase (
    	label pointer copy TestToCall lblTestCaseArrayLocalOverride
    )
    
    label lblTestCaseArrayParameterIn testArrayDefaultValue
    call testCase (
    	label pointer copy TestToCall lblTestCaseArrayDefaultValue
    )

end proc