namespace SimStmTest

proc testSuiteArray ()

    call testCase (
    	label set TestToCall testArray
    )
    
    call testCase (
        label set TestToCall testArrayGet
    )
    
    call testCase (
    	label set TestToCall testCaseArraySet
    )

    call testCase (
    	label set TestToCall testCaseArraySize
    )

    call testCase (
    	label set TestToCall testCaseArrayPointerCopy
    )

    call testCase (
    	label set TestToCall testCaseArrayParameterIn
    )

    call testCase (
    	label set TestToCall testCaseArrayParameterOut
    )

    call testCase (
    	label set TestToCall testCaseLocal
    )

    call testCase (
    	label set TestToCall testCaseArrayLocalOverride
    )

    call testCase (
    	label set TestToCall testCaseArrayDefaultValue
    )

end proc

end namespace