namespace SimStmTest

proc testSuiteOther ()

    call stm.testCase (
    	label set TestToCall testOtherRandom
    )

    call stm.testCase (
    	label set TestToCall testOtherSeed
    )

    call stm.testCase (
    	label set TestToCall testOtherTrace
    )
    
    call stm.testCase (
    	label set TestToCall testOtherMarker
    )

    call stm.testCase (
    	label set TestToCall testOtherWait
    )

    call stm.testCase (
    	label set TestToCall testOtherLogSubstitutions
    )

    call stm.testCase (
    	label set TestToCall testOtherLogFormats
    )

    call stm.testCase (
    	label set TestToCall testOtherLog
    )

    call stm.testCase (
    	label set TestToCall testOtherHelloWorld
    )

    call stm.testCase (
    	label set TestToCall testOtherCall
    )
end proc

end namespace