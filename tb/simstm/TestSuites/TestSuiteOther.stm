testSuiteOther:
proc
    call testCaseOtherRandom ()
    call testCaseOtherSeed ()
    call testCaseOtherTrace ()
    call testCaseOtherMarker ()
    call testCaseOtherWait ()
    call testCaseOtherLogSubstitutions ()
    call testCaseOtherLogFormats ()
    call testCaseOtherLog ()
    call testCaseOtherHelloWorld ()
    call testCaseOtherCall ()
end proc


proc testCaseOtherRandom ()

    call beginTestCase ()

    if SKIP = NOT_SKIPPED
        lines append message TestCaseLines "TestCase not implemented yet"
        call skipTestCase
	    call endTestCase ()
        return
    end if

    call testOtherRandom

    if StandardTestFailure != 0
        lines append message TestCaseLines "OtherRandom test failed"
        call failureTestCase
    end if

    call endTestCase ()

end proc


