
proc testSuiteIndexedSampleSuiteOnlyIndex ()
    call testCaseSampleSuiteOnlyIndexA ()
    call testCaseSampleSuiteOnlyIndexB ()
end proc


proc testCaseSampleSuiteOnlyIndexA (
	var skipped 0
)
    var t 0

    call beginTestCaseSuiteIndexed ()
    equ t TestSuiteIndex
    add t 1
    seed t
    call testOtherRandom ()

    call endTestCase ( 
    	equ  skipped skipped
    	equ failure StandardTestFailure
    )

end proc


proc testCaseSampleSuiteOnlyIndexB (
	var skipped 0
)
    var t 0

    call beginTestCaseSuiteIndexed ()
    equ t TestSuiteIndex
    add t 1
    seed t
    call testOtherRandom ()

    call endTestCase ( 
    	equ  skipped skipped
    	equ failure StandardTestFailure
    )

end proc