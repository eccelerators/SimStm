proc testSuiteFile ()
	
    call testCase (
    	label set TestToCall testFileAppendArray
    )

    call testCase (
    	label set TestToCall testFileReadAllArray
    )

    call testCase (
    	label set TestToCall testFileReadArray
    )

    call testCase (
    	label set TestToCall testFileStatus
    )

    call testCase (
    	label set TestToCall testFileWriteArray
    )

    call testCase (
    	label set TestToCall testFilePointerCopy
    )

    call testCase (
    	label set TestToCall testFileLocalOverride
    )

    call testCase (
    	label set TestToCall testFileLocal
    )

    call testCase (
    	label set TestToCall testFileParameterIn
    )

    call testCase (
    	label set TestToCall testFileParameterOut
    )
end proc

