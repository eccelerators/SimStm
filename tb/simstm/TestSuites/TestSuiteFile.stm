proc testSuiteFile ()
	
	label lblTestFileAppendArray testFileAppendArray
    call testCase (
    	label pointer copy TestToCall lblTestFileAppendArray
    )
    
    label lblTestFileReadAllArray testFileReadAllArray
    call testCase (
    	label pointer copy TestToCall lblTestFileReadAllArray
    )
    
    label lblTestFileReadArray testFileReadArray
    call testCase (
    	label pointer copy TestToCall lblTestFileReadArray
    )
    
    label lblTestFileStatus testFileStatus
    call testCase (
    	label pointer copy TestToCall lblTestFileStatus
    )
    
    label lblTestFileWriteArray testFileWriteArray
    call testCase (
    	label pointer copy TestToCall lblTestFileWriteArray
    )
    
    label lblTestFilePointerCopy testFilePointerCopy
    call testCase (
    	label pointer copy TestToCall lblTestFilePointerCopy
    )
    
    label lblTestFileLocalOverride testFileLocalOverride
    call testCase (
    	label pointer copy TestToCall lblTestFileLocalOverride
    )
    
    label lblTestFileLocal testFileLocal
    call testCase (
    	label pointer copy TestToCall lblTestFileLocal
    )
    
    label lblTestFileParameterIn testFileParameterIn
    call testCase (
    	label pointer copy TestToCall lblTestFileParameterIn
    )
    
    label lblTestFileParameterOut testFileParameterOut
    call testCase (
    	label pointer copy TestToCall lblTestFileParameterOut
    )
end proc

