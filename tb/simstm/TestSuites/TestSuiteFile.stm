testSuiteFile:
proc
    call testCaseFileAppendArray ()
    call testCaseFileReadAllArray ()
    call testCaseFileReadArray ()
    call testCaseFileStatus ()
    call testCaseFileWriteArray ()
    call testCaseFilePointerCopy ()
end proc

proc testCaseFileAppendArray (
	var skipped 0
)
    call beginTestCase ()
    call testFileAppendArray ()
    call endTestCase ( 
    	equ  skipped skipped
    	equ failure StandardTestFailure
    )
end proc

proc testCaseFileReadAllArray (
	var skipped 0
)
    call beginTestCase ()
    call testFileReadAllArray ()
    call endTestCase ( 
    	equ  skipped skipped
    	equ failure StandardTestFailure
    )
end proc

proc testCaseFileReadArray (
	var skipped 0
)
    call beginTestCase ()
    call testFileReadArray ()
    call endTestCase ( 
    	equ  skipped skipped
    	equ failure StandardTestFailure
    )
end proc

proc testCaseFileStatus (
	var skipped 0
)
    call beginTestCase ()
    call testFileStatus ()
    call endTestCase ( 
    	equ  skipped skipped
    	equ failure StandardTestFailure
    )
end proc

proc testCaseFileWriteArray (
	var skipped 0
)
    call beginTestCase ()
    call testFileWriteArray ()
    call endTestCase ( 
    	equ  skipped skipped
    	equ failure StandardTestFailure
    )
end proc

proc testCaseFilePointerCopy (
	var skipped 0
)
    call beginTestCase ()
    call testFilePointerCopy ()
    call endTestCase ( 
    	equ  skipped skipped
    	equ failure StandardTestFailure
    )
end proc