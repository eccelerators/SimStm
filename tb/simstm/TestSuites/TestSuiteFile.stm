proc testSuiteFile ()

    call testCaseFileAppendArray ()
    call testCaseFileReadAllArray ()
    call testCaseFileReadArray ()
    call testCaseFileStatus ()
    call testCaseFileWriteArray ()
    call testCaseFilePointerCopy ()
    call testCaseFileLocalOverride ()
    call testCaseFileLocal ()
    call testCaseFileParameterIn ()
    call testCaseFileParameterOut ()
end proc

proc testCaseFileAppendArray (
	var skipped 0
)
    call beginTestCase ()
    call testFileAppendArray ()
    call endTestCase ( 
    	equ  skipped skipped
    	equ failure StandardTestFailure
    )
end proc

