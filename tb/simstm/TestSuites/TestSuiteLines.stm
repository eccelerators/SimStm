proc testSuiteLines ()

	label lblTestLinesAppendArray testLinesAppendArray
    call testCase (
    	label pointer copy TestToCall lblTestLinesAppendArray
    )
    label lblTestLinesAppendText testLinesAppendText
    call testCase (
    	label pointer copy TestToCall lblTestLinesAppendText
    )
    label lblTestLinesDeleteAllArray testLinesDeleteAllArray
    call testCase (
    	label pointer copy TestToCall lblTestLinesDeleteAllArray
    )
    label lblTestLinesDeleteArray testLinesDeleteArray
    call testCase (
    	label pointer copy TestToCall lblTestLinesDeleteArray
    )
    
    label lblTestLinesGetArray testLinesGetArray
    call testCase (
    	label pointer copy TestToCall lblTestLinesGetArray
    )
    
    label lblTestLinesInsertArray testLinesInsertArray
    call testCase (
    	label pointer copy TestToCall lblTestLinesInsertArray
    )
    
    label lblTestLinesInsertText testLinesInsertText
    call testCase (
    	label pointer copy TestToCall lblTestLinesInsertText
    )
    
    label lblTestLinesPointerCopy testLinesPointerCopy
    call testCase (
    	label pointer copy TestToCall lblTestLinesPointerCopy
    )
    
    label lblTestLinesSetArray testLinesSetArray
    call testCase (
    	label pointer copy TestToCall lblTestLinesSetArray
    )
    
    label lblTestLinesSetText testLinesSetText
    call testCase (
    	label pointer copy TestToCall lblTestLinesSetText
    )
    
    label lblTestLinesSize testLinesSize
    call testCase (
    	label pointer copy TestToCall lblTestLinesSize
    )
    
    label lblTestLinesLocal testLinesLocal
    call testCase (
    	label pointer copy TestToCall lblTestLinesLocal
    )
    
    label lblTestLinesParameterIn testLinesParameterIn
    call testCase (
    	label pointer copy TestToCall lblTestLinesParameterIn
    )
    
    label lblTestLinesParameterOut testLinesParameterOut
    call testCase (
    	label pointer copy TestToCall lblTestLinesParameterOut
    )
    
    label lblTestLinesLocalOverride testLinesLocalOverride
    call testCase (
    	label pointer copy TestToCall lblTestLinesLocalOverride
    )
end proc

