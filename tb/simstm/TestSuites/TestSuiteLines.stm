include "../Lines/lines.stm"
include "../Lines/lines_local.stm"
include "../Lines/lines_local_override.stm"
include "../Lines/lines_parameter.stm"
include "../Lines/lines_pointer.stm"

namespace SimStmTest

proc testSuiteLines ()

    call stm.testCase (
    	label set TestToCall testLinesAppendArray
    	equ skipped 1
    )

    call stm.testCase (
    	label set TestToCall testLinesAppendText
    )

    call stm.testCase (
    	label set TestToCall testLinesDeleteAllArray
    	equ skipped 1
    )

    call stm.testCase (
    	label set TestToCall testLinesDeleteArray
    	equ skipped 1
    )

    call stm.testCase (
    	label set TestToCall testLinesGetArray
    	equ skipped 1
    )

    call stm.testCase (
    	label set TestToCall testLinesInsertArray
    	equ skipped 1
    )

    call stm.testCase (
    	label set TestToCall testLinesInsertText
    )

    call stm.testCase (
    	label set TestToCall testLinesPointerCopy
    )

    call stm.testCase (
    	label set TestToCall testLinesSetArray
    	equ skipped 1
    )

    call stm.testCase (
    	label set TestToCall testLinesSetText
    )

    call stm.testCase (
    	label set TestToCall testLinesSize
    )

    call stm.testCase (
    	label set TestToCall testLinesLocal
    	equ skipped 1
    )

    call stm.testCase (
    	label set TestToCall testLinesParameterIn
    	equ skipped 1
    )

    call stm.testCase (
    	label set TestToCall testLinesParameterOut
    	equ skipped 1
    )

    call stm.testCase (
    	label set TestToCall testLinesLocalOverride
    	equ skipped 1
    )
end proc

end namespace

