var sampleCaseOnlyIndexA 1

proc testSuiteSampleCaseOnlyIndex ()

    loop 5
        call testCaseSampleCaseOnlyIndexA ()
        add sampleCaseOnlyIndexA 1
    end loop
end proc


proc testCaseSampleCaseOnlyIndexA (
	var skipped 0
)

    equ TestCaseIndex sampleCaseOnlyIndexA
    call beginTestCaseIndexed ()

    seed sampleCaseOnlyIndexA
    call testOtherRandom

    call endTestCase ( 
    	equ  skipped skipped
    	equ failure StandardTestFailure
    )

end proc