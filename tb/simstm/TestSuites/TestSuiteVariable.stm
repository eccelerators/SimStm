proc testSuiteVariable ()

    call testCaseVariableAdd ()
    call testCaseVariableAnd ()
    call testCaseVariableDiv ()
    call testCaseVariableEqu ()
    call testCaseVariableMul ()
    call testCaseVariableOr ()
    call testCaseVariableSub ()
    call testCaseVariableXor ()
    call testCaseVariableInv ()
    call testCaseVariableLd ()
    call testCaseVariableLocal ()
    call testCaseVariableLocalOverride ()
    call testCaseVariablePointer ()
    call testCaseVariableParameterIn ()
    call testCaseVariableParameterOut ()
    call testCaseVariableDefaultValue ()
end proc


proc testCaseVariableDefaultValue (
	var skipped 0
)
    call beginTestCase ()    
    call testVariableLocalOverride ()
    call endTestCase ( 
    	equ  skipped skipped
    	equ failure StandardTestFailure
    )
end proc

