proc testSuiteVariable ()
	
	label lblTestVariableAdd testVariableAdd
    call testCase (
    	label pointer copy TestToCall lblTestVariableAdd
    )
    
    label lblTestVariableAnd testVariableAnd
    call testCase (
    	label pointer copy TestToCall lblTestVariableAnd
    )
    
    label lblTestVariableDiv testVariableDiv
    call testCase (
    	label pointer copy TestToCall lblTestVariableDiv
    )
    
    label lblTestVariableEqu testVariableEqu
    call testCase (
    	label pointer copy TestToCall lblTestVariableEqu
    )
    
    label lblTestVariableMul testVariableMul
    call testCase (
    	label pointer copy TestToCall lblTestVariableMul
    )
    
    label lblTestVariableOr testVariableOr
    call testCase (
    	label pointer copy TestToCall lblTestVariableOr
    )
    
    label lblTestVariableSub testVariableSub
    call testCase (
    	label pointer copy TestToCall lblTestVariableSub
    )
    
    label lblTestVariableXor testVariableXor
    call testCase (
    	label pointer copy TestToCall lblTestVariableXor
    )
    
     
    label lblTestVariableInv testVariableInv
    call testCase (
    	label pointer copy TestToCall lblTestVariableInv
    )
    
     
    label lblTestVariableLd testVariableLd
    call testCase (
    	label pointer copy TestToCall lblTestVariableLd
    )
    
     
    label lblTestVariableLocal testVariableLocal
    call testCase (
    	label pointer copy TestToCall lblTestVariableLocal
    )
    
     
    label lblTestVariableLocalOverride testVariableLocalOverride
    call testCase (
    	label pointer copy TestToCall lblTestVariableLocalOverride
    )
    
     
    label lblTestVariablePointer testVariablePointer
    call testCase (
    	label pointer copy TestToCall lblTestVariablePointer
    )
    
     
    label lblTestVariableParameterIn testVariableParameterIn
    call testCase (
    	label pointer copy TestToCall lblTestVariableParameterIn
    )
    
    label lblTestVariableParameterOut testVariableParameterOut
    call testCase (
    	label pointer copy TestToCall lblTestVariableParameterOut
    )
    
    label lblTestVariableDefaultValue testVariableDefaultValue
    call testCase (
    	label pointer copy TestToCall lblTestVariableDefaultValue
    	)
end proc


proc testCaseVariableLd (
	var skipped 0
)
    call beginTestCase ()    
    call testVariableLd ()
    call endTestCase ( 
    	equ  skipped skipped
    	equ failure StandardTestFailure
    )
end proc


