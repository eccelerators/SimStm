include "../Variable/variable.stm"
include "../Variable/variable_default_value.stm"
include "../Variable/variable_local.stm"
include "../Variable/variable_local_override.stm"
include "../Variable/variable_parameter.stm"
include "../Variable/variable_pointer.stm"

namespace SimStmTest

proc testSuiteVariable ()
	
    call stm.testCase (
    	label set TestToCall testVariableAdd
    )
    
    call stm.testCase (
    	label set TestToCall testVariableAnd
    )
    
    call stm.testCase (
    	label set TestToCall testVariableDiv
    )
    
    call stm.testCase (
    	label set TestToCall testVariableEqu
    )
    
    call stm.testCase (
    	label set TestToCall testVariableMul
    )
    
    call stm.testCase (
    	label set TestToCall testVariableOr
    )

    call stm.testCase (
    	label set TestToCall testVariableSub
    )
    
    call stm.testCase (
    	label set TestToCall testVariableXor
    )
    
    call stm.testCase (
    	label set TestToCall testVariableInv
    )
    
    call stm.testCase (
    	label set TestToCall testVariableLd
    )
    
    call stm.testCase (
    	label set TestToCall testVariableLocal
    )
    
    call stm.testCase (
    	label set TestToCall testVariableLocalOverride
    )
    
    call stm.testCase (
    	label set TestToCall testVariablePointer
    )

    call stm.testCase (
    	label set TestToCall testVariableParameterIn
    )
 
    call stm.testCase (
    	label set TestToCall testVariableParameterOut
    )

    call stm.testCase (
    	label set TestToCall testVariableDefaultValue
    	)
end proc

end namespace