            call testCaseBus64VerifyFail (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus64TimeOutRead (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus64TimeOutWrite (
		    	bus pointer copy busToTest busToTest
		    )
            add TestCaseBus64Index 1
        end if
    elsif RepeatedTestSuiteIndex = 6
        if MachineValueWidth >= 32
            bus pointer copy busToTest axi4lite32
            bus timeout set busToTest 1000
            equ TestCaseIndex TestCaseBus32Index
            call testCaseBus32 (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus32VerifySuccess (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus32VerifyFail (
