            call testCaseBus32TimeOutRead (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus32TimeOutWrite (
		    	bus pointer copy busToTest busToTest
		    )
            add TestCaseBus32Index 1
        end if
    end if
end proc


proc testCaseBus32 (
	bus busToTest 0
)
    file pointer copy TestCaseStartFile TestCaseBus32StartFile
    file pointer copy TestCaseFile TestCaseBus32File
    call beginTestCaseIndexedSuiteIndexed

    if SKIP = NOT_SKIPPED
        lines append message TestCaseLines "TestCase not implemented yet"
        call skipTestCase
        call endTestCase
        return
    end if

    call logBusToTest (
    	bus pointer copy busToTest busToTest
    )
    call testBus32 (
    	bus pointer copy busToTest busToTest
    )

     if StandardTestFailure != 0
        lines append message TestCaseLines "Bus32 test failed"
        call failureTestCase
    end if

    call endTestCase

end proc

