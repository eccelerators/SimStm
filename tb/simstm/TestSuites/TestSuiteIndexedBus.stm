var TestCaseBus32Index 0
var TestCaseBus64Index 0
var TestCaseBus128Index 0
var TestCaseBus256Index 0
var RepeatedTestSuiteIndex 0

proc testSuiteIndexedBus ()
    bus busToTest NO_BUS
    equ RepeatedTestSuiteIndex TestSuiteIndex
    rem RepeatedTestSuiteIndex 8
    if RepeatedTestSuiteIndex <= 3
        if MachineValueWidth >= 32
            bus pointer copy busToTest wishbone32
            bus timeout set busToTest 1000
            equ TestCaseIndex TestCaseBus32Index
            call testCaseBus32 (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus32VerifySuccess (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus32VerifyFail (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus32TimeOutRead (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus32TimeOutWrite (
		    	bus pointer copy busToTest busToTest
		    )
            add TestCaseBus32Index 1
        end if
        if MachineValueWidth >= 64
            bus pointer copy busToTest wishbone64
            bus timeout set busToTest 1000
            equ TestCaseIndex TestCaseBus64Index
            call testCaseBus64 (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus64VerifySuccess (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus64VerifyFail (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus64TimeOutRead (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus64TimeOutWrite (
		    	bus pointer copy busToTest busToTest
		    )
            add TestCaseBus64Index 1
        end if
        if MachineValueWidth >= 128
            bus pointer copy busToTest wishbone128
            bus timeout set busToTest 1000
            equ TestCaseIndex TestCaseBus128Index
            call testCaseBus128 (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus128VerifySuccess (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus128VerifyFail (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus128TimeOutRead (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus128TimeOutWrite (
		    	bus pointer copy busToTest busToTest
		    )
            add TestCaseBus128Index 1
        end if
        if MachineValueWidth >= 256
            bus pointer copy busToTest wishbone256
            bus timeout set busToTest 1000
            equ TestCaseIndex TestCaseBus256Index
            call testCaseBus256 (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus256VerifySuccess (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus256VerifyFail (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus256TimeOutRead (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus256TimeOutWrite (
		    	bus pointer copy busToTest busToTest
		    )
            add TestCaseBus256Index 1
        end if
    elsif RepeatedTestSuiteIndex <= 5
        if MachineValueWidth >= 32
            bus pointer copy busToTest avalon32
            bus timeout set busToTest 1000
            equ TestCaseIndex TestCaseBus32Index
            call testCaseBus32 (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus32VerifySuccess (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus32VerifyFail (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus32TimeOutRead (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus32TimeOutWrite (
		    	bus pointer copy busToTest busToTest
		    )
            add TestCaseBus32Index 1
        end if
        if MachineValueWidth >= 64
            bus pointer copy busToTest avalon64
            bus timeout set busToTest 1000
            equ TestCaseIndex TestCaseBus64Index
            call testCaseBus64 (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus64VerifySuccess (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus64VerifyFail (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus64TimeOutRead (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus64TimeOutWrite (
		    	bus pointer copy busToTest busToTest
		    )
            add TestCaseBus64Index 1
        end if
    elsif RepeatedTestSuiteIndex = 6
        if MachineValueWidth >= 32
            bus pointer copy busToTest axi4lite32
            bus timeout set busToTest 1000
            equ TestCaseIndex TestCaseBus32Index
            call testCaseBus32 (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus32VerifySuccess (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus32VerifyFail (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus32TimeOutRead (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus32TimeOutWrite (
		    	bus pointer copy busToTest busToTest
		    )
            add TestCaseBus32Index 1
        end if
    elsif RepeatedTestSuiteIndex = 7
        if MachineValueWidth >= 32
            bus pointer copy busToTest ram32
            bus timeout set busToTest 1000
            equ TestCaseIndex TestCaseBus32Index
            call testCaseBus32 (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus32VerifySuccess (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus32VerifyFail (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus32TimeOutRead (
		    	bus pointer copy busToTest busToTest
		    )
            call testCaseBus32TimeOutWrite (
		    	bus pointer copy busToTest busToTest
		    )
            add TestCaseBus32Index 1
        end if
    end if
end proc


proc testCaseBus32 (
	bus busToTest 0
)
    call beginTestCaseIndexedSuiteIndexed ()

    if SKIP = NOT_SKIPPED
        lines append message TestCaseLines "TestCase not implemented yet"
        call skipTestCase
	    call endTestCase ()
        return
    end if

    call logBusToTest (
    	bus pointer copy busToTest busToTest
    )
    call testBus32 (
    	bus pointer copy busToTest busToTest
    )

     if StandardTestFailure != 0
        lines append message TestCaseLines "Bus32 test failed"
        call failureTestCase
    end if

    call endTestCase ()

end proc

