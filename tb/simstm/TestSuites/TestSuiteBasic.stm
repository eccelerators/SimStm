
proc testSuiteBasic ()

	label lblTestBasicConst testBasicConst
    call testCase (
    	label pointer copy TestToCall lblTestBasicConst
    )
    
    label lblTestBasicIfElseElsif testBasicIfElseElsif
    call testCase (
    	label pointer copy TestToCall lblTestBasicIfElseElsif
    )
    
    label lblTestBasicNestedIfElseElsif testBasicNestedIfElseElsif
    call testCase (
    	label pointer copy TestToCall lblTestBasicNestedIfElseElsif
    )
    
    label lblTestBasicLoop testBasicLoop
    call testCase (
    	label pointer copy TestToCall lblTestBasicLoop
    )
    
    label lblTestBasicVar testBasicVar
    call testCase (
    	label pointer copy TestToCall lblTestBasicVar
    )
    
    label lblTestBasicVar3 testBasicVar3
    call testCase (
    	label pointer copy TestToCall lblTestBasicVar3
    )

end proc