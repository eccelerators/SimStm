namespace SimStmTest

proc testSuiteBasic ()

    call stm.testCase (
    	label set TestToCall testBasicConst
    )

    call stm.testCase (
    	label set TestToCall testBasicIfElseElsif
    )

    call stm.testCase (
    	label set TestToCall testBasicNestedIfElseElsif
    )

    call stm.testCase (
    	label set TestToCall testBasicLoop
    )

    call stm.testCase (
    	label set TestToCall testBasicVar
    )

    call stm.testCase (
    	label set TestToCall testBasicVar3
    )

end proc

end namespace