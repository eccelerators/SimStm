proc testSuiteBasic ()

    call testCaseBasicConst ()
    call testCaseBasicIfElseElsif ()
    call testCaseBasicNestedIfElseElsif ()
    call testCaseBasicLoop ()
    call testCaseBasicVar ()
    call testCaseBasicVar3 ()
end proc

proc testCaseBasicLoop (
	var skipped 0
)
    call beginTestCase ()
    call testBasicLoop ()
    call endTestCase ( 
    	equ  skipped skipped
    	equ failure StandardTestFailure
    )
end proc

