namespace SimStmTest

var sampleCaseIndexA 0
var sampleCaseIndexB 0

proc testSuiteIndexedSampleSuiteAndCaseIndex ()
    equ sampleCaseIndexA 0
    equ sampleCaseIndexB 0
    loop 3
        call testCaseSampleSuiteAndCaseIndexA ()
        add sampleCaseIndexA 5
    end loop
    loop 4
        call testCaseSampleSuiteAndCaseIndexB ()
        add sampleCaseIndexB 10
    end loop
end proc


proc testCaseSampleSuiteAndCaseIndexA (
	var skipped 0
)
    var t 0
    equ TestCaseIndex sampleCaseIndexA
    call beginTestCaseIndexedSuiteIndexed ()
    equ t TestSuiteIndex
    add t 1
    add t TestSuiteIndex
    seed t
    call testOtherRandom ()
    call endTestCase ( 
    	equ  skipped skipped
    	equ failure StandardTestFailure
    )
end proc


proc testCaseSampleSuiteAndCaseIndexB (
	var skipped 0
)
    var t 0
    equ TestCaseIndex sampleCaseIndexB
    call beginTestCaseIndexedSuiteIndexed ()
    equ t TestSuiteIndex
    add t 100000
    add t TestSuiteIndex

    seed t
    call testOtherRandom ()
    call endTestCase ( 
    	equ  skipped skipped
    	equ failure StandardTestFailure
    )

end proc

end namespace