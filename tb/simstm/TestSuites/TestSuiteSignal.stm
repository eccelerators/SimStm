
proc testSuiteSignal ()

label lblTestSignalWriteReadVerify testSignalWriteReadVerify
    call testCase (
    	label pointer copy TestToCall lblTestSignalWriteReadVerify
    )
    
    label lblTestSignalVerifyFail testSignalVerifyFail
    call testCase (
    	label pointer copy TestToCall lblTestSignalVerifyFail
    )
    
    label lblTestSignalPointerCopy testSignalPointerCopy
    call testCase (
    	label pointer copy TestToCall lblTestSignalPointerCopy
    )
    
    label lblTestSignalPointerGetSet testSignalPointerGetSet
    call testCase (
    	label pointer copy TestToCall lblTestSignalPointerGetSet
    )
end proc