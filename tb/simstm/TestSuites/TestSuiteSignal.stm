include "../Common/interface.stm"
include "../Signal/signal_base.stm"
include "../Signal/signal_verify_failure.stm"
include "../Signal/signal_extend.stm"
include "../Signal/signal_local_override.stm"
include "../Signal/signal_parameter.stm"
include "../Signal/signal_pointer.stm"
include "../Signal/signal_scoping.stm"

namespace SimStmTest

proc testSuiteSignal ()

    call stm.testCase (
    	label set TestToCall testSignalSimpleLoopbackBit
    )

    call stm.testCase (
    	label set TestToCall testSignalSimpleLoopbackVector
    )

    call stm.testCase (
    	label set TestToCall testSignalSimpleLoopbackCross
    )

    call stm.testCase (
        label set TestToCall testSignalVerifyDecDec
    )
    call stm.testCase (
        label set TestToCall testSignalVerifyHexHex
    )
    call stm.testCase (
        label set TestToCall testSignalVerifyBinBin
    )
    call stm.testCase (
        label set TestToCall testSignalVerifyDecHex
    )
    call stm.testCase (
        label set TestToCall testSignalVerifyDecBin
    )
    call stm.testCase (
        label set TestToCall testSignalVerifyHexDec
    )
    call stm.testCase (
        label set TestToCall testSignalVerifyHexBin
    )
    call stm.testCase (
        label set TestToCall testSignalVerifyBinDec
    )
    call stm.testCase (
        label set TestToCall testSignalVerifyBinHex
    )
    call stm.testCase (
        label set TestToCall testSignalVerifyVarDec
    )
    call stm.testCase (
        label set TestToCall testSignalVerifyVarHex
    )
    call stm.testCase (
        label set TestToCall testSignalVerifyVarBin
    )
    call stm.testCase (
        label set TestToCall testSignalVerifyDecVar
    )
    call stm.testCase (
        label set TestToCall testSignalVerifyHexVar
    )
    call stm.testCase (
        label set TestToCall testSignalVerifyBinVar
    )
    call stm.testCase (
        label set TestToCall testSignalVerifyVarVar
    )
    call stm.testCase (
        label set TestToCall testSignalVerifyFail
    )
    call stm.testCase (
        label set TestToCall testSignalLocalOverride
    )
    call stm.testCase (
        label set TestToCall testSignalParameter
    )
    call stm.testCase (
        label set TestToCall testSignalPointerCopy
    )
    call stm.testCase (
        label set TestToCall testSignalPointerGet
    )
    call stm.testCase (
        label set TestToCall testSignalPointerSet
    )
    call stm.testCase (
        label set TestToCall testSignalSimpleScope
    )

end proc

end namespace