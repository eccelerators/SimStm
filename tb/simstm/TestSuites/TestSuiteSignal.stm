namespace SimStmTest

proc testSuiteSignal ()

    call stm.testCase (
    	label set TestToCall testSignalWriteReadVerify
    )

    call stm.testCase (
    	label set TestToCall testSignalVerifyFail
    )

    call stm.testCase (
    	label set TestToCall testSignalPointerCopy
    )

    call stm.testCase (
    	label set TestToCall testSignalPointerGetSet
    )
end proc

end namespace