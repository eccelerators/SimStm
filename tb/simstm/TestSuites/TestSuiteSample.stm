testSuiteSample:
proc
    call testCaseSampleA ()
end proc


proc testCaseSampleA ()

    call beginTestCase ()

    if SKIP = NOT_SKIPPED
        lines append message TestCaseLines "TestCase not implemented yet"
        call skipTestCase
	    call endTestCase ()
        return
    end if

    call testOtherRandom

    if StandardTestFailure != 0
        lines append message TestCaseLines "SampleA test failed"
        call failureTestCase
    end if

    call endTestCase ()

end proc

proc testCaseSampleB ()

    call beginTestCase ()

    if SKIP = NOT_SKIPPED
        lines append message TestCaseLines "TestCase not implemented yet"
        call skipTestCase
	    call endTestCase ()
        return
    end if

    call testOtherRandom

    if StandardTestFailure != 0
        lines append message TestCaseLines "SampleB test failed"
        call failureTestCase
    end if

    call endTestCase ()

end proc