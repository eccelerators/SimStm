include "../../lib/base.stm"
include "../../lib/testcase.stm"
include "Common/common.stm"
include "Common/interface.stm"

include "Other/other.stm"

include "TestSuites/TestSuiteOther.stm"
namespace SimStmTest
proc testMainSuiteOther ()

    

    verbosity stm.INFO_2
    trace stm.TRACE_OFF
    resume stm.RESUME_ON_ALL_FAILURES
    call initDut()
    log message stm.INFO "Main test suite Sample started"

    call testSuiteOther ()

    log message stm.INFO "Main test suite Sample ended"
    wait 1000
    finish
end proc
end namespace
