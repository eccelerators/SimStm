
	var test_variable_local_override_add_1 8
	var test_variable_local_override_add_2 9

proc testVariableLocalOverride ()

	var test_variable_local_override_add_1 1
	var test_variable_local_override_add_2 2

    call startStandardTestShell ()
    
    log message INFO_2 "test_variable_local_override_add_1 local: {:d}" test_variable_local_override_add_1
    log message INFO_2 "test_variable_local_override_add_2 local: {:d}" test_variable_local_override_add_2

    add test_variable_local_override_add_1 10
    add test_variable_local_override_add_2 20

    log message INFO_2 "test_variable_local_override_add_1 local: {:d}" test_variable_local_override_add_1
    log message INFO_2 "test_variable_local_override_add_2 local: {:d}" test_variable_local_override_add_2
    var verify test_variable_local_override_add_1 11 MAX
    var verify test_variable_local_override_add_2 22 MAX
	call checkVariableGlobal ()
    call endStandardTestShell ()

end proc


proc checkVariableGlobal ()
    log message INFO_2 "test_variable_local_override_add_1 global: {:d}" test_variable_local_override_add_1
    log message INFO_2 "test_variable_local_override_add_2 global: {:d}" test_variable_local_override_add_2
    var verify test_variable_local_override_add_1 8 MAX
    var verify test_variable_local_override_add_2 9 MAX
end proc
