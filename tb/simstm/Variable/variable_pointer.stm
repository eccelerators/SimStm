
proc testVariablePointer ()

	var test_variable_pointer_1 1
	var test_variable_pointer_2 2

    call startStandardTestShell
    
    log message INFO_2 "test_variable_local_add_1 local: {:d}" test_variable_pointer_1
    log message INFO_2 "test_variable_local_add_2 local: {:d}" test_variable_pointer_2

    var pointer copy test_variable_pointer_1 test_variable_pointer_2

    log message INFO_2 "test_variable_local_add_2 local: {:d}" test_variable_pointer_2
    var verify test_variable_pointer_1 2 MAX

    call endStandardTestShell

end proc
