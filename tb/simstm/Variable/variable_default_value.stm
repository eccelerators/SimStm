
proc testVariableDefaultValue ()

	var y_val 17
	call startStandardTestShell ()
    call checkVariableParameter ()
	call endStandardTestShell ()
end proc

proc checkVariableParameter (
	var z_val 1
	)

	log message INFO_2 "value of parameter: {:d}" z_val
	var verify z_val 1 MAX
	add z_val 2
	log message INFO_2 "new value of parameter: {:d}" z_val
	var verify z_val 3 MAX
end proc