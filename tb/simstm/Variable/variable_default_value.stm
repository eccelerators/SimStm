namespace SimStmTest
proc testVariableDefaultValue ()

	var y_val 17
	call stm.startStandardTestShell ()
    call checkVariableParameter ()
	call stm.endStandardTestShell ()
end proc

proc checkVariableParameter (
	var z_val 1
	)

	log message stm.INFO_2 "value of parameter: {:d}" z_val
	var verify z_val 1 stm.MAX
	add z_val 2
	log message stm.INFO_2 "new value of parameter: {:d}" z_val
	var verify z_val 3 stm.MAX
end proc

end namespace