
proc testVariableParameterIn ()
    var in_val 0xBB
    call startStandardTestShell
    
    call checkParameterInput ( 
    	equ par_in_1 0xAA
    	equ par_in_2 in_val
    )

    call endStandardTestShell
end proc


proc checkParameterInput ( 
	var par_in_1 0
	var par_in_2 0
)
    log message INFO_2 "test_variable_local_add_1 local: {:d}" par_in_1
    log message INFO_2 "test_variable_local_add_2 local: {:d}" par_in_2
	var verify par_in_1 0xAA MAX
	var verify par_in_2 0xBB MAX	
end proc


proc testVariableParameterOut ()
    
    var out_val 0
    call startStandardTestShell
    -- trace TRACE_INSTRUCTIONS
    call setParameterOutput ( 
    	var pointer copy par_out out_val
    )
    var verify out_val 0xAB MAX

    call endStandardTestShell
end proc


proc setParameterOutput ( 
	var par_out 0
)
    -- var result 0
    -- var pointer copy result par_out
    equ par_out 0xAB
end proc