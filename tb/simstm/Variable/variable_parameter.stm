
proc testVariableParameter ()
    
    var par_out 0

    call $startStandardTestShell
    
    call $checkParameterInput ( 
    	var pointer copy par_in par_out
    )

    call $endStandardTestShell

end proc


proc checkParameterInput ( 
	var par_in 0
)
    equ par_out 0xab
	var verify par_in 0xAA $MAX
end proc


