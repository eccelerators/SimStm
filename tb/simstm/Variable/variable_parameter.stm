
proc testVariableParameterIn ()
    var in_val 0xBB
    call stm.startStandardTestShell ()
    
    call checkVariableParameterInput ( 
    	equ par_in_1 0xAA
    	equ par_in_2 in_val
    )

    call stm.endStandardTestShell ()
end proc


proc checkVariableParameterInput ( 
	var par_in_1 0
	var par_in_2 0
)
    log message stm.INFO_2 "par_in_1 local: {:d}" par_in_1
    log message stm.INFO_2 "par_in_2 local: {:d}" par_in_2
	var verify par_in_1 0xAA stm.MAX
	var verify par_in_2 0xBB stm.MAX	
end proc


proc testVariableParameterOut ()
    
    var out_val 0
    call stm.startStandardTestShell ()
    -- trace TRACE_INSTRUCTIONS
    call setParameterOutput ( 
    	var pointer copy par_out out_val
    )
    var verify out_val 0xAB stm.MAX

    call stm.endStandardTestShell ()
end proc


proc setParameterOutput ( 
	var par_out 0
)
    -- var result 0
    -- var pointer copy result par_out
    equ par_out 0xAB
end proc