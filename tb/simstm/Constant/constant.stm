namespace SimStmTest

var test_constant_add_1 1
var test_constant_add_2 2

var test_variable_add_1 1
var test_variable_add_2 2


proc testConstantAdd ()
    call stm.startStandardTestShell ()
    call unitConstantAdd ()
    call stm.endStandardTestShell ()
end proc

proc unitConstantAdd ()
    log message 0 "test_variable_1: {}" test_variable_add_1
    log message 0 "test_variable_2: {}" test_variable_add_2

    add test_variable_add_1 test_constant_add_1
    add test_variable_add_2 test_constant_add_2
    var verify test_variable_add_1 2 stm.MAX
    var verify test_variable_add_2 4 stm.MAX

    log message 0 "test_variable_1: {}" test_variable_add_1
    log message 0 "test_variable_2: {}" test_variable_add_2

    add test_variable_add_1 test_constant_add_1
    add test_variable_add_2 test_constant_add_2
    var verify test_variable_add_1 3 stm.MAX
    var verify test_variable_add_2 6 stm.MAX

    log message 0 "test_variable_1: {}" test_variable_add_1
    log message 0 "test_variable_2: {}" test_variable_add_2

end proc

end namespace