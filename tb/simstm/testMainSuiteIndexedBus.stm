include "../../lib/base.stm"
include "../../lib/testcase.stm"
include "Common/common.stm"
include "Common/interface.stm"

include "Bus/bus32.stm"
include "Bus/bus64.stm"
include "Bus/bus128.stm"
include "Bus/bus256.stm"

include "TestSuites/TestSuiteIndexedBus.stm"
namespace SimStmTest
const testMainSuiteIndexedRangeLengthBus 32

proc testMainSuiteIndexedBus ()

    verbosity stm.INFO_2
    trace stm.TRACE_OFF
    resume stm.RESUME_ON_ALL_FAILURES
    call initDut()
    signal read stm.sigInTestSuiteIndex stm.TestSuiteIndex
    log message stm.INFO "Main test main suite indexed Bus {:d} started" stm.TestSuiteIndex

    call testSuiteIndexedBus ()

    log message stm.INFO "Main test main suite indexed Bus {:d} ended" stm.TestSuiteIndex
    wait 1000
    finish
end proc

end namespace