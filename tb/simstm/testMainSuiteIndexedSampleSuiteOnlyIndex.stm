include "../../lib/base.stm"
include "../../lib/testcase.stm"
include "Common/common.stm"
include "Common/interface.stm"

include "Other/other.stm"

include "TestSuites/TestSuiteIndexedSampleSuiteOnlyIndex.stm"
namespace SimStmTest
const testMainSuiteIndexedRangeLengthSampleSuiteOnlyIndex 4

proc testMainSuiteIndexedSampleSuiteOnlyIndex ()
            
    verbosity stm.INFO_2
    trace stm.TRACE_OFF
    resume stm.RESUME_ON_ALL_FAILURES
    call initDut()
    signal read stm.sigInTestSuiteIndex stm.TestSuiteIndex
    log message stm.INFO "Main test main suite indexed SampleSuiteOnlyIndex {:d} started" stm.TestSuiteIndex
                
    call testSuiteIndexedSampleSuiteOnlyIndex ()
    
    log message stm.INFO "Main test main suite indexed SampleSuiteOnlyIndex {:d} ended" stm.TestSuiteIndex
    wait 1000
    finish
end proc
end namespace
