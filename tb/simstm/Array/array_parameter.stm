
proc testArrayParameterIn ()

	array p_array 2
	array set p_array 0 99
	array set p_array 1 100
	var size_var 100
	array size p_array size_var
	call startStandardTestShell ()
	
	call checkArrayParameterInput (
		array pointer copy this_array p_array
	)
	call endStandardTestShell ()
end proc

proc checkArrayParameterInput (
	array this_array 0
	)
	var pos_0 12
	var pos_1 13
	array get this_array 0 pos_0
	array get this_array 1 pos_1
	log message INFO_2 "index 0 of the array is: {:d}" pos_0
	log message INFO_2 "index 1 of the array is: {:d}" pos_1

	array verify this_array 0 99 MAX
	array verify this_array 1 100 MAX
	
end proc

proc testArrayParameterOut ()

	array p_array 2
	array set p_array 0 99
	array set p_array 1 100
	var size_var 100
	array size p_array size_var
	call startStandardTestShell ()
	
	call setArrayParameterOutput (
		array pointer copy this_array p_array
	)
	
	array verify p_array 0 19 MAX
	array verify p_array 1 20 MAX
end proc 

proc setArrayParameterOutput (
	array this_array 1
	)
	
	array set this_array 0 19
	array set this_array 1 20
end proc
