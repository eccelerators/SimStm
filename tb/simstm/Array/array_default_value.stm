namespace SimStmTest

proc testArrayDefaultValue ()
	call stm.startStandardTestShell ()
	call unitArrayDefaultValue ()
	call stm.endStandardTestShell ()	
end proc

proc unitArrayDefaultValue (
    array default_array 3
) 
    var val_pos_0 11
    var val_pos_1 12
    var val_pos_2 23
    
    var cmp_pos_0 0
    var cmp_pos_1 0
    var cmp_pos_2 0
    
    array set default_array 0 val_pos_0
    array set default_array 1 val_pos_1
    array set default_array 2 val_pos_2
   
    array get default_array 0 cmp_pos_0
    array get default_array 1 cmp_pos_1
    array get default_array 2 cmp_pos_2
    
    array verify default_array 0 cmp_pos_0 stm.MAX
    array verify default_array 1 cmp_pos_1 stm.MAX
    array verify default_array 2 cmp_pos_2 stm.MAX
    
end proc

end namespace

