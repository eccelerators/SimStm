namespace SimStmTest

array test_array_pointer_src_array 10
array test_array_pointer_des_array 1

var test_array_pointer_var 0

proc testArrayPointerCopy ()
    call stm.startStandardTestShell ()
    call unitArrayPointerCopy ()
    call stm.endStandardTestShell ()
end proc

proc unitArrayPointerCopy ()
    array size test_array_pointer_src_array test_array_pointer_var
    var verify test_array_pointer_var 10 stm.MAX

    array size test_array_pointer_des_array test_array_pointer_var
    var verify test_array_pointer_var 1 stm.MAX

    array set test_array_pointer_src_array 0 10
    array set test_array_pointer_src_array 1 11
    array set test_array_pointer_src_array 2 12

    array pointer copy test_array_pointer_des_array test_array_pointer_src_array

    array size test_array_pointer_src_array test_array_pointer_var
    var verify test_array_pointer_var 10 stm.MAX

    array size test_array_pointer_des_array test_array_pointer_var
    var verify test_array_pointer_var 10 stm.MAX

    array get test_array_pointer_des_array 0 test_array_pointer_var
    var verify test_array_pointer_var 10 stm.MAX

    array get test_array_pointer_des_array 1 test_array_pointer_var
    var verify test_array_pointer_var 11 stm.MAX

    array get test_array_pointer_des_array 2 test_array_pointer_var
    var verify test_array_pointer_var 12 stm.MAX

    array set test_array_pointer_des_array 5 55

    array get test_array_pointer_src_array 5 test_array_pointer_var
    var verify test_array_pointer_var 55 stm.MAX
end proc

end namespace