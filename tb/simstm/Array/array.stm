namespace SimStmTest

array test_array_name 3

var test_array_var 10

proc testArray ()

    call stm.startStandardTestShell ()

    array set test_array_name 0 3
    array get test_array_name 0 test_array_var
    var verify test_array_var 3 stm.MAX
    array verify test_array_name 0 3 stm.MAX

    equ test_array_var 1234
    array set test_array_name 1 test_array_var
    array get test_array_name 1 test_array_var
    var verify test_array_var 1234 stm.MAX
    array verify test_array_name 1 1234 stm.MAX

    array get test_array_name 0 test_array_var
    var verify test_array_var 3 stm.MAX
    array verify test_array_name 0 3 stm.MAX

    call stm.endStandardTestShell ()
end proc

proc testArrayGet ()
    call stm.startStandardTestShell ()

    array set test_array_name 0 3
    array get test_array_name 0 test_array_var
    var verify test_array_var 3 stm.MAX

    equ test_array_var 1234
    array set test_array_name 1 test_array_var
    array get test_array_name 1 test_array_var
    var verify test_array_var 1234 stm.MAX

    array get test_array_name 0 test_array_var
    var verify test_array_var 3 stm.MAX

    call stm.endStandardTestShell ()
end proc

proc testArraySet ()

    call stm.startStandardTestShell ()

    array set test_array_name 0 3
    array get test_array_name 0 test_array_var
    var verify test_array_var 3 stm.MAX

    equ test_array_var 1234
    array set test_array_name 1 test_array_var
    array get test_array_name 1 test_array_var
    var verify test_array_var 1234 stm.MAX

    array get test_array_name 0 test_array_var
    var verify test_array_var 3 stm.MAX

    call stm.endStandardTestShell ()
end proc

end namespace
