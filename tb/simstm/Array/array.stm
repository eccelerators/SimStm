array test_array_name 3

var test_array_var 10

testArray:
proc
    call startStandardTestShell ()

    array set test_array_name 0 3
    array get test_array_name 0 test_array_var
    var verify test_array_var 3 MAX
    array verify test_array_name 0 3 MAX

    equ test_array_var 1234
    array set test_array_name 1 test_array_var
    array get test_array_name 1 test_array_var
    var verify test_array_var 1234 MAX
    array verify test_array_name 1 1234 MAX

    array get test_array_name 0 test_array_var
    var verify test_array_var 3 MAX
    array verify test_array_name 0 3 MAX

    call endStandardTestShell ()
end proc

testArrayGet:
proc
    call startStandardTestShell ()

    array set test_array_name 0 3
    array get test_array_name 0 test_array_var
    var verify test_array_var 3 MAX

    equ test_array_var 1234
    array set test_array_name 1 test_array_var
    array get test_array_name 1 test_array_var
    var verify test_array_var 1234 MAX

    array get test_array_name 0 test_array_var
    var verify test_array_var 3 MAX

    call endStandardTestShell ()
end proc

testArraySet:
proc
    call startStandardTestShell ()

    array set test_array_name 0 3
    array get test_array_name 0 test_array_var
    var verify test_array_var 3 MAX

    equ test_array_var 1234
    array set test_array_name 1 test_array_var
    array get test_array_name 1 test_array_var
    var verify test_array_var 1234 MAX

    array get test_array_name 0 test_array_var
    var verify test_array_var 3 MAX

    call endStandardTestShell ()
end proc
