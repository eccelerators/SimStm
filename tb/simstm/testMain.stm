lines success_lines
file simulation_success "simulation.success"

proc testMain ()

    trace TRACE_OFF
    -- trace TRACE_EXECUTED_LINES
    -- trace TRACE_INSTRUCTIONS
    -- trace TRACE_CALLS
    resume RESUME_ON_ALL_ERRORS
    verbosity INFO_2
    signal write out_signal_init_dut 1
    wait 1000
    signal write out_signal_init_dut 0
    call initBase ()
    log message INFO "Main test started"

    call testSignalWriteReadVerify ()
    call testSignalVerifyFail ()
    call testSignalParameterIn ()
    call testSignalLocalOverride ()

    -- call testFileAppendArray ()
    -- call testFileWriteArray ()
    -- call testFileReadArray ()
    -- call testFilePointer ()
    -- call testFileLocal ()
    -- call testFileLocalOverride ()
    -- call testFileParameterIn ()
    -- call testFileParameterOut ()
    -- call testVariableInv ()
    call testOtherRandom ()

    -- call testNamespaceTwoDifferentOnes ()
    -- call testNamespaceLocalAndGlobal ()

    -- bus pointer copy busToTest wishbone256
    -- bus timeout set busToTest 1000
    -- call testVariableLocalOverride ()
    -- call testVariableLocal ()
    -- call testVariableScope ()
    -- call testVariablePointer ()
    -- call testVariableParameterIn ()
    -- call testVariableParameterOut ()
    -- call testVariableDefaultValue ()


    -- call testLinesSize  ()
    -- call testLinesLocalOverride ()
	-- call testLinesLocal ()
	-- call testLinesParameterIn ()
	-- call testLinesParameterOut ()
	-- call testLinesPointer ()

    -- call testArrayLocalOverride ()
    -- call testArrayLocal ()
    -- call testArrayParameterIn ()
    -- call testArrayDefaultValue ()

    -- call testSuiteArray ()
    -- call testSuiteVariable ()

    -- call testCallProcDirect ()
    -- call testCallLabelIndirect ()

    log message INFO "Main test finished"
    wait 1000
    lines append message success_lines "SUCCESS"
    -- stop
    log lines INFO success_lines
    file write simulation_success success_lines
    wait 1000
    finish
end proc
