include "../../lib/base.stm"
include "Common/common.stm"
include "Label/label.stm"

namespace SimStmTest

    lines success_lines
    file simulation_success "simulation.success"

    proc testMain ()

        resume stm.RESUME_ON_ALL_FAILURES
        verbosity stm.INFO_2
        call initDut()

        log message stm.INFO "Main test started"

        call testArrayParameterIn ()
        call testInterrupt ()
        call testLinesGetArray ()
        call testLinesInsertArray ()
		
        log message stm.INFO "Main test finished"
        wait 1000
        lines append message success_lines "SUCCESS"
        -- stop
        log lines stm.INFO success_lines
        file write simulation_success success_lines
        wait 1000
        finish
    end proc

end namespace