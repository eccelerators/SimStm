namespace SimStmTest

proc testFileParameterIn ()
    call stm.startStandardTestShell ()
    call unitFileParameterIn ()
    call stm.endStandardTestShell ()
end proc

proc unitFileParameterIn ()
	file a_file "a_file.dat"
	lines a_lines
	array a_array 2
	array set a_array 0 1
	array set a_array 1 2
	lines delete all a_lines
	lines append array a_lines a_array
	file write a_file a_lines
	call checkFileParameterInput (
		file pointer copy this_file a_file
	)
end proc

proc checkFileParameterInput (
	file this_file ""
	)

	lines result_lines
	array this_array 2
	var a_var 99
	var b_var 99
	file read all this_file result_lines
	lines get array result_lines 0 this_array a_var
	array verify this_array 0 1 stm.MAX
	array verify this_array 1 2 stm.MAX
	log lines stm.INFO_2 result_lines

end proc

proc testFileParameterOut ()
    call stm.startStandardTestShell ()
    call unitFileParameterOut ()
    call stm.endStandardTestShell ()
end proc

proc unitFileParameterOut ()
	file b_file "b_file.dat"
	array a_array 2
	array set a_array 0 1
	array set a_array 1 2
	lines b_lines
	lines result_lines
	lines delete all b_lines
	lines append array b_lines a_array
	file write b_file b_lines
	call checkFileParameterOutput (
		file pointer copy this_file b_file
	)
	file read all b_file result_lines
	array final_array_a 2
	array final_array_b 1
	var a_var 99
	var b_var 99
	lines get array result_lines 0 final_array_a a_var 
	lines get array result_lines 1 final_array_b b_var 
	array verify final_array_a 0 1 stm.MAX
	array verify final_array_a 1 2 stm.MAX
	array verify final_array_b 0 3 stm.MAX
	log lines stm.INFO_2 result_lines
end proc

proc checkFileParameterOutput (
	file this_file "b_file.dat"
	)
	
	array b_array 1
	array set b_array 0 3
	lines more_numbers
	lines append array more_numbers b_array
	file append this_file more_numbers
end proc

end namespace