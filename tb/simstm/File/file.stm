end proc


proc testFileReadAllArray ()

    call startStandardTestShell ()

    array set test_file_a_array 0 0
    array set test_file_a_array 1 1
    array set test_file_a_array 2 0xA
    array set test_file_a_array 3 2
    array set test_file_a_array 4 0xB
    array set test_file_a_array 5 0x7FFFFFFF
    array set test_file_a_array 6 0x80000000
    array set test_file_a_array 7 0xFFFFFFFF
    lines delete all file_a_lines
    lines append array file_a_lines test_file_a_array

    array set test_file_a_array 0 1
    lines append array file_a_lines test_file_a_array

    array set test_file_a_array 0 2
    lines append array file_a_lines test_file_a_array

    file write user_data_out_read_all_array file_a_lines

    lines delete all test_file_b_lines
    file read all user_data_out_read_all_array test_file_b_lines
    lines size test_file_b_lines FileTmpResult
    var verify FileTmpResult 3 MAX

    call endStandardTestShell ()
end proc

var read_elements_got 0

proc testFileReadArray ()

    call startStandardTestShell ()

    array set test_file_a_read_array 0 0
    array set test_file_a_read_array 1 0
    array set test_file_a_read_array 2 0
    array set test_file_a_read_array 3 0
    array set test_file_a_read_array 4 0
    array set test_file_a_read_array 5 0
    array set test_file_a_read_array 6 0
    array set test_file_a_read_array 7 0

    array verify test_file_a_read_array 0 0 MAX

    array set test_file_b_read_array 0 0
    array set test_file_b_read_array 1 0
    array set test_file_b_read_array 2 0
    array set test_file_b_read_array 3 0
    array set test_file_b_read_array 4 0
    array set test_file_b_read_array 5 0
    array set test_file_b_read_array 6 0
    array set test_file_b_read_array 7 0

    array set test_file_c_read_array 0 0
    array set test_file_c_read_array 1 0
    array set test_file_c_read_array 2 0
    array set test_file_c_read_array 3 0
    array set test_file_c_read_array 4 0
    array set test_file_c_read_array 5 0
    array set test_file_c_read_array 6 0
    array set test_file_c_read_array 7 0

    array set test_file_a_array 0 0
    array set test_file_a_array 1 1
    array set test_file_a_array 2 0xA
    array set test_file_a_array 3 2
    array set test_file_a_array 4 0xB
    array set test_file_a_array 5 0x7FFFFFFF
    array set test_file_a_array 6 0x80000000
    array set test_file_a_array 7 0xFFFFFFFF
    lines delete all file_a_lines

    lines append array file_a_lines test_file_a_array

    array set test_file_a_array 0 1
    lines append array file_a_lines test_file_a_array

    array set test_file_a_array 0 2
    lines append array file_a_lines test_file_a_array

    file write user_data_out_read_array file_a_lines

    wait 1000

    file read user_data_out_read_array test_file_a_read_lines 1
    lines size test_file_a_read_lines FileTmpResult
    var verify FileTmpResult 1 MAX

    file read user_data_out_read_array test_file_b_read_lines 1
    lines size test_file_b_read_lines FileTmpResult
    var verify FileTmpResult 1 MAX

    file read user_data_out_read_array test_file_c_read_lines 1
    lines size test_file_c_read_lines FileTmpResult
    var verify FileTmpResult 1 MAX

    file read end user_data_out_read_array

    lines get array test_file_a_read_lines 0 test_file_a_read_array read_elements_got
    var verify read_elements_got 8 MAX
    lines get array test_file_b_read_lines 0 test_file_b_read_array read_elements_got
    var verify read_elements_got 8 MAX
    lines get array test_file_c_read_lines 0 test_file_c_read_array read_elements_got
    var verify read_elements_got 8 MAX

    call arrayDump (
    	array pointer copy Array test_file_b_read_array
    )
    call arrayDump (
    	array pointer copy Array test_file_b_read_array
    )
    call arrayDump (
    	array pointer copy Array test_file_c_read_array
    )

    array verify test_file_a_read_array 0 0 MAX
    array verify test_file_b_read_array 0 1 MAX
    array verify test_file_c_read_array 0 2 MAX

    call endStandardTestShell ()
end proc

proc testFileStatus ()

    call startStandardTestShell ()

    array set test_file_a_array 0 0
    array set test_file_a_array 1 1
    array set test_file_a_array 2 0xA
    array set test_file_a_array 3 2
    array set test_file_a_array 4 0xB
    array set test_file_a_array 5 0x7FFFFFFF
    array set test_file_a_array 6 0x80000000
    array set test_file_a_array 7 0xFFFFFFFF
    lines delete all file_a_lines
    lines append array file_a_lines test_file_a_array

    array set test_file_a_array 0 1
    lines append array file_a_lines test_file_a_array

    array set test_file_a_array 0 2
    lines append array file_a_lines test_file_a_array
	var FileStatus 0
    log message 0 "Check if file is readable, which doesn't exist"
    file readable user_data_out_not_present FileStatus
    call printFileStatus (
    	equ FileStatus FileStatus
    )
    var verify FileStatus FILE_STATUS_NAME_ERROR MAX

    -- No means to delete a file with VHDL, thus not testable since file is constructed if it doesn't exist by writable test
    -- Would only fail if file is write protected by OS
    -- log message 0 "Check if file is writeable, which doesn't exist"
    -- file writeable user_data_not_present FileStatus
    -- call printFileStatus

    -- No means to delete a file with VHDL, thus not testable since file is constructed if it doesn't exist by appendable test
    -- Would only fail if file is write protected by OS
    -- log message 0 "Check if file is appendable, which doesn't exist"
    -- file appendable user_data_not_present FileStatus
    -- call printFileStatus

    log message 0 "Check if file is readable, which exist"
  
    file writable user_data_out_present FileStatus -- constructs file
    call printFileStatus (
    	equ FileStatus FileStatus
    )
    var verify FileStatus FILE_STATUS_OK MAX

    log message 0 "Check if file is readable, which exist"
    file appendable user_data_out_present FileStatus
    call printFileStatus ()
    var verify FileStatus FILE_STATUS_OK MAX

    log message 0 "Check if file is readable, which exist"
    file readable user_data_out_present FileStatus
    call printFileStatus ()
    var verify FileStatus FILE_STATUS_OK MAX

    call endStandardTestShell ()
end proc

proc testFilePointerCopy ()

    call startStandardTestShell ()

    array set test_file_a_array 0 0
    array set test_file_a_array 1 1
    array set test_file_a_array 2 0xA
    array set test_file_a_array 3 2
    array set test_file_a_array 4 0xB
    array set test_file_a_array 5 0x7FFFFFFF
    array set test_file_a_array 6 0x80000000
    array set test_file_a_array 7 0xFFFFFFFF
    lines delete all file_a_lines
    lines append array file_a_lines test_file_a_array

    array set test_file_a_array 0 1
    lines append array file_a_lines test_file_a_array

    array set test_file_a_array 0 2
    lines append array file_a_lines test_file_a_array

    -- log lines 0 a_lines

    file pointer copy tmp_file user_data_out_pointer_copy
    call WriteFile ()

    lines delete all test_file_b_lines
    file read all user_data_out_pointer_copy test_file_b_lines
    lines size test_file_b_lines FileTmpResult
    var verify FileTmpResult 3 MAX

    call endStandardTestShell ()
end proc

proc WriteFile ()

    file write tmp_file file_a_lines
end proc