    lines append array file_a_lines test_file_a_array

    array set test_file_a_array 0 2
    lines append array file_a_lines test_file_a_array

    file write user_data_out_append_array file_a_lines

    file append user_data_out_append_array file_a_lines

    lines delete all test_file_b_lines
    file read all user_data_out_append_array test_file_b_lines
    lines size test_file_b_lines FileTmpResult
