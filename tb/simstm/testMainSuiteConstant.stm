include "../../lib/base.stm"
include "../../lib/testcase.stm"
include "Common/common.stm"
include "Common/interface.stm"

include "Constant/constant.stm"

include "TestSuites/TestSuiteConstant.stm"
namespace SimStmTest
proc testMainSuiteConstant ()

    

    verbosity stm.INFO_2
    trace stm.TRACE_OFF
    resume stm.RESUME_ON_ALL_FAILURES
    call initDut()
    log message stm.INFO "Main test suite Constant started"

    call testSuiteConstant ()

    log message stm.INFO "Main test suite Constant ended"
    wait 1000
    finish
end proc

end namespace