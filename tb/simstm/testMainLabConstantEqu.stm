
include "Common/CommonLabs.stm"
include "TestLabs/TestLabConstantEqu.stm"

include "Constant/constant_labs.stm"

namespace SimStmTest
file simulation_success "simulation.success"
lines success_lines

proc testMainLabConstantEqu ()

    

    verbosity stm.INFO_2
    trace 0
    resume 1
    signal write out_signal_init_dut 1
    wait 1000
    signal write out_signal_init_dut 0
    log message stm.INFO "Main test started"

    call testLabConstantEqu ()

    log message stm.INFO "Main test finished"
    wait 1000
    lines append message success_lines "SUCCESS"
    file write simulation_success success_lines
    finish
end proc

end namespace