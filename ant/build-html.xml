<?xml version="1.0" encoding="UTF-8"?>
<project name="SimStmSubtargetsAndMacros">    

	<target name="rst2html-sphinx" depends="-collect-sources-for-sphinx-html-transformation">	
		<exec executable="${python-executable}">
			<arg value="-m" />
			<arg value="sphinx" />
			<arg value="-b" />
			<arg value="html" />
			<arg value="tmp-gen/source" />
			<arg value="tmp-gen/build" />
		</exec>  
		<copy todir="src-gen/html-sphinx">
			<fileset dir="tmp-gen/build">
				<include name="**/*" />
			</fileset>
		</copy>		
	</target>
	
    <target name="-collect-sources-for-sphinx-html-transformation" >
    	<run_collect-sources-for-sphinx-transformation targettype="html-sphinx"/> 
    </target>	
	
	<macrodef name="run_collect-sources-for-sphinx-transformation">
        <attribute name="targettype"/>
        <sequential>
            <antcall target="-collect-sources-for-sphinx-transformation">
                <param name="targettype" value="@{targettype}"/>
            </antcall>
        </sequential>
    </macrodef>
    <target name="-collect-sources-for-sphinx-transformation">
        <delete failonerror="false" includeemptydirs="true">
            <fileset dir="tmp-gen">
                <include name="**/*" />
            </fileset>
        </delete>
        <copy todir="tmp-gen/source">
            <fileset dir="submodules/sphinx_template/source">
                <include name="**/*" />
            </fileset>
        </copy>
        <copy todir="tmp-gen/source">
            <fileset dir="src/rst">
                <include name="**/*.rst" />
                <exclude name="**/index_pdf.rst" />
                <exclude name="**/index_html.rst" />
            </fileset>
        </copy>  
        <if> 
            <available file="src/rst/resources" type="dir"/>
            <then>
                <copy todir="tmp-gen/source/resources" failonerror="false">
                    <fileset dir="src/rst/resources">
                        <include name="**/*.png" />
                    </fileset>
                </copy>
            </then>
        </if>
        <copy todir="tmp-gen/source">
            <fileset dir="src-gen/rst">
                <include name="**/*.rst" />
            </fileset>
        </copy>          	    	
        <copy todir="tmp-gen/source/resources">
            <fileset dir="src-gen/rst">
                <include name="**/*.png" />
            </fileset>
        </copy>        
        <copy file="src/rst/index_html.rst" tofile="tmp-gen/source/index.rst" />
    </target>
	
</project>