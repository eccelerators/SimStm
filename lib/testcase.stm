namespace stm

lines TestCaseStartLines
lines TestCaseLines
var TestCaseLinesPosition 0
var TestCaseAssertionsInsertionPoint 0
var TestCasePropertiesInsertionPoint 0

signal sigInTestSuiteIndex 2
var TestSuiteIndex 255

var TestCaseIndex 0xFFFFFFFF
var TestCaseHasIndex 0
var TestSuiteHasIndex 0

var TestCaseSimulatedStartTime 0
var TestCaseSimulatedEndTime 0
var TestCaseSimulatedDurationTime 0

proc beginTestSuiteIndexedAndCaseIndexed ()
    log message stm.ALWAYS "**********START*TESTCASE*{@c3}_{:d}_{@c2}_{:d}**********" stm.TestSuiteIndex TestCaseIndex
    equ TestSuiteHasIndex 1
    equ TestCaseHasIndex 1
    lines delete all TestCaseLines
    signal read stm.sigInSimulatedTimeNow TestCaseSimulatedStartTime 
    lines append message TestCaseStartLines "test case started"
    
    file TestCaseStartFile "../../SimulationResults/{@c3}_{:d}_{@c2}_{:d}.start" stm.TestSuiteIndex TestCaseIndex   
    file write TestCaseStartFile TestCaseStartLines

    lines append message TestCaseLines '<testcase'
    lines append message TestCaseLines ' name="{@c3}_{:d}_{@c2}_{:d}"' stm.TestSuiteIndex TestCaseIndex
    lines size TestCaseLines TestCaseLinesPosition
    equ TestCaseAssertionsInsertionPoint TestCaseLinesPosition

    lines append message TestCaseLines ' classname="{@c3}_{:d}"' stm.TestSuiteIndex
    lines append message TestCaseLines ' file="{@f1}"'
    lines append message TestCaseLines ' line="{@l1}"'
    lines append message TestCaseLines '>'

    lines size TestCaseLines TestCaseLinesPosition
    equ TestCasePropertiesInsertionPoint TestCaseLinesPosition
end proc

proc beginTestCaseSuiteIndexed ()
    log message stm.ALWAYS "**********START*TESTCASE*{@c3}_{:d}_{@c2}**********" stm.TestSuiteIndex
    equ TestSuiteHasIndex 1
    equ TestCaseHasIndex 0
    lines delete all TestCaseLines
    signal read stm.sigInSimulatedTimeNow TestCaseSimulatedStartTime
    lines append message TestCaseStartLines "test case started"
	file TestCaseStartFile "../../SimulationResults/{@c3}_{:d}_{@c2}.start" stm.TestSuiteIndex
    file write TestCaseStartFile TestCaseStartLines

    lines append message TestCaseLines '<testcase'
    lines append message TestCaseLines ' name="{@c3}_{:d}_{@c2}"' stm.TestSuiteIndex
    lines size TestCaseLines TestCaseLinesPosition
    equ TestCaseAssertionsInsertionPoint TestCaseLinesPosition

    lines append message TestCaseLines ' classname="{@c3}_{:d}"' stm.TestSuiteIndex
    lines append message TestCaseLines ' file="{@f1}"'
    lines append message TestCaseLines ' line="{@l1}"'
    lines append message TestCaseLines '>'

    lines size TestCaseLines TestCaseLinesPosition
    equ TestCasePropertiesInsertionPoint TestCaseLinesPosition
end proc


proc beginTestCaseIndexed ()
    log message stm.ALWAYS "**********START*TESTCASE*{@c3}_{@c2}_{:d}**********" TestCaseIndex
    equ TestSuiteHasIndex 0
    equ TestCaseHasIndex 1
    lines delete all TestCaseLines
    signal read stm.sigInSimulatedTimeNow TestCaseSimulatedStartTime
    lines append message TestCaseStartLines "test case started"
    file TestCaseStartFile "../../SimulationResults/{@c3}_{@c2}_{:d}.start" TestCaseIndex
    file write TestCaseStartFile TestCaseStartLines

    lines append message TestCaseLines '<testcase'
    lines append message TestCaseLines ' name="{@c3}_{@c2}_{:d}"' TestCaseIndex
    lines size TestCaseLines TestCaseLinesPosition
    equ TestCaseAssertionsInsertionPoint TestCaseLinesPosition

    lines append message TestCaseLines ' classname="{@c3}"'
    lines append message TestCaseLines ' file="{@f1}"'
    lines append message TestCaseLines ' line="{@l1}"'
    lines append message TestCaseLines '>'

    lines size TestCaseLines TestCaseLinesPosition
    equ TestCasePropertiesInsertionPoint TestCaseLinesPosition
end proc


proc beginTestCase ()
    log message stm.ALWAYS "**********START*TESTCASE*{@c3}_{@c2}**********"
    equ TestSuiteHasIndex 0
    equ TestCaseHasIndex 0
    lines delete all TestCaseLines
    signal read stm.sigInSimulatedTimeNow TestCaseSimulatedStartTime
    log message stm.ALWAYS "Started at simulation time of {:d}ns" TestCaseSimulatedStartTime
    lines append message TestCaseStartLines "test case started"
    file TestCaseStartFile "../../SimulationResults/{@c3}_{@c2}.start"
    file write TestCaseStartFile TestCaseStartLines

    lines append message TestCaseLines '<testcase'
    lines append message TestCaseLines ' name="{@c3}_{@c2}"'
    lines size TestCaseLines TestCaseLinesPosition
    equ TestCaseAssertionsInsertionPoint TestCaseLinesPosition

    lines append message TestCaseLines ' classname="{@c3}"'
    lines append message TestCaseLines ' file="{@f1}"'
    lines append message TestCaseLines ' line="{@l1}"'
    lines append message TestCaseLines '>'

    lines size TestCaseLines TestCaseLinesPosition
    equ TestCasePropertiesInsertionPoint TestCaseLinesPosition
end proc


proc endTestCase (
	var skipped 0
	var error 0
	var failure 0
)
    if skipped != 0
        call skipTestCase ()
    elsif error != 0
        call errorTestCase ()
    elsif failure != 0
        call failureTestCase ()
    end if
    signal read stm.sigInSimulatedTimeNow TestCaseSimulatedEndTime
    log message stm.ALWAYS "Ended at simulation time of {:d}ns" TestCaseSimulatedEndTime
    equ TestCaseSimulatedDurationTime TestCaseSimulatedEndTime
    sub TestCaseSimulatedDurationTime TestCaseSimulatedStartTime
    lines insert message TestCaseLines TestCaseAssertionsInsertionPoint' assertions="{:d}"' stm.StandardTestVerifyAssertionsCountResult
    add TestCasePropertiesInsertionPoint 1
    lines append message TestCaseLines '</testcase>'
    lines insert message TestCaseLines TestCasePropertiesInsertionPoint '</properties>'
    lines insert message TestCaseLines TestCasePropertiesInsertionPoint '<property name="SimulatedDuration" value="{:d}"/>' TestCaseSimulatedDurationTime
    lines insert message TestCaseLines TestCasePropertiesInsertionPoint '<property name="SimulatedEndTime" value="{:d}"/>' TestCaseSimulatedEndTime
    lines insert message TestCaseLines TestCasePropertiesInsertionPoint '<property name="SimulatedStartTime" value="{:d}"/>' TestCaseSimulatedStartTime
    lines insert message TestCaseLines TestCasePropertiesInsertionPoint '<properties>'
    -- file last modified time is test case end real time

    if TestSuiteHasIndex = 1
        if TestCaseHasIndex = 1
            file TestCaseIndexedSuiteIndexedFile "../../SimulationResults/{@c3}_{:d}_{@c2}_{:d}.xml" stm.TestSuiteIndex TestCaseIndex
            file append TestCaseIndexedSuiteIndexedFile TestCaseLines
            log message stm.ALWAYS "**********END*TESTCASE*{@c3}_{:d}_{@c2}_{:d}**********" stm.TestSuiteIndex TestCaseIndex
        else
            file TestSuiteIndexedFile "../../SimulationResults/{@c3}_{:d}_{@c2}.xml" stm.TestSuiteIndex
            file append TestSuiteIndexedFile TestCaseLines
            log message stm.ALWAYS "**********END*TESTCASE*{@c3}_{:d}_{@c2}**********" stm.TestSuiteIndex
        end if
     else
        if TestCaseHasIndex = 1
            file TestCaseIndexedFile "../../SimulationResults/{@c3}_{@c2}_{:d}.xml" TestCaseIndex
            file append TestCaseIndexedFile TestCaseLines
            log message stm.ALWAYS "**********END*TESTCASE*{@c3}_{@c2}_{:d}**********" TestCaseIndex
        else
            file TestCaseFile "../../SimulationResults/{@c3}_{@c2}.xml"
            file append TestCaseFile TestCaseLines
            log message stm.ALWAYS "**********END*TESTCASE*{@c3}_{@c2}**********"
        end if
     end if
end proc

proc skipTestCase ()
    lines size TestCaseLines TestCaseLinesPosition
    sub TestCaseLinesPosition 1
    lines insert message TestCaseLines TestCaseLinesPosition "<skipped message=\""
     lines append message TestCaseLines "\"/>"
end proc


proc errorTestCase ()
    lines size TestCaseLines TestCaseLinesPosition
    sub TestCaseLinesPosition 1
    lines insert message TestCaseLines TestCaseLinesPosition "<error message=\""
     lines append message TestCaseLines "\"/>"
end proc

proc failureTestCase ()
    lines size TestCaseLines TestCaseLinesPosition
    sub TestCaseLinesPosition 1
    lines insert message TestCaseLines TestCaseLinesPosition "<failure message=\""
     lines append message TestCaseLines "\"/>"
end proc

proc testTemplate ()
    call stm.startStandardTestShell ()
    log message 0 "testTemplate shall never be called directly, it shall be overridden in any case"
    call stm.endStandardTestShell ()
end proc

proc testCase (
    label TestToCall testTemplate
    var skipped 0
)
    call beginTestCase ()
    call label TestToCall ()
    call endTestCase ( 
        equ  skipped skipped
        equ failure stm.StandardTestFailure
    )
end proc

proc testCaseWithCaseIndex (
    label TestToCall testTemplate
    var skipped 0
)
    call beginTestCaseIndexed ()
    call label TestToCall ()
    call endTestCase ( 
        equ  skipped skipped
        equ failure stm.StandardTestFailure
    )
end proc

proc testCaseWithSuiteIndex (
    label TestToCall testTemplate
    var skipped 0
)
    call beginTestCaseSuiteIndexed ()
    call label TestToCall ()
    call endTestCase ( 
        equ  skipped skipped
        equ failure stm.StandardTestFailure
    )
end proc

proc testCaseWithSuiteAndCaseIndex (
    label TestToCall testTemplate
    var skipped 0
)
    call beginTestSuiteIndexedAndCaseIndexed ()
    call label TestToCall ()
    call endTestCase ( 
        equ  skipped skipped
        equ failure stm.StandardTestFailure
    )
end proc

end namespace
