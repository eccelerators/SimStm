include "../common/common.stm"

namespace CounterCaseIndexed

proc testCountUp (
    var StepValue stm.TestCaseIndex
)
    var expextedCount 0
    
    call stm.startStandardTestShell ()
    call initDut ()    
    signal write sigOutStepValue StepValue
    signal verify sigInCount expextedCount 0xFF
    loop 4
        call countUp ()    
        add expextedCount StepValue  
        signal verify sigInCount expextedCount 0xFF
        wait 1000
    end loop
    call stm.endStandardTestShell ()
end proc

proc testCountDown (
    var StepValue stm.TestCaseIndex
)
    var expextedCount 0
    
    call stm.startStandardTestShell ()
    call initDut () 
    signal write sigOutStepValue StepValue
    signal verify sigInCount expextedCount 0xFF
    loop 4
        call countDown ()    
        sub expextedCount StepValue 
        signal verify sigInCount expextedCount 0xFF
        wait 1000
    end loop
    call stm.endStandardTestShell ()
end proc

end namespace