include "common/common.stm"

namespace CounterCaseIndexed

proc testCountUp (
    var StepValue stm.TestCaseIndex
)
    var expextedCount 0
    
    call stm.startStandardTestShell ()
    call initDut ()    
    signal write out_signal_StepValue StepValue
    signal verify in_signal_Count expextedCount stm.MAX
    loop 4
        call countUp ()    
        add expextedCount 1  
        signal verify in_signal_Count expextedCount stm.MAX
        wait 1000
    end loop
    call stm.endStandardTestShell ()
end proc

proc testCountDown (
    var StepValue stm.TestCaseIndex
)
    var expextedCount 0
    
    call stm.startStandardTestShell ()
    call initDut () 
    signal write out_signal_StepValue StepValue
    signal verify in_signal_Count expextedCount stm.MAX
    loop 4
        call countDown ()    
        sub expextedCount 1  
        signal verify in_signal_Count expextedCount stm.MAX
        wait 1000
    end loop
    call stm.endStandardTestShell ()
end proc

end namespace