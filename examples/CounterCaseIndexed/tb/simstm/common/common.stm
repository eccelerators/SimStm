include "../../../../../lib/base.stm"
include "../../../../../lib/testcase.stm"
include "../TestSuites/TestSuiteCount.stm"
include "../count/count.stm"

namespace CounterCaseIndexed

var WaitTimeOut 100000 -- ms

const NO_SIGNAL 0

signal out_signal_init_dut 1

signal out_signal_interrupt_a 1000
signal out_signal_interrupt_b 1001

signal in_signal_2000 2000
signal in_signal_Active 2000

signal in_signal_2001 2001
signal in_signal_Count 2001

signal in_signal_2002 2002
signal in_signal_2003 2003

signal out_signal_3000 3000
signal out_signal_3001 3001
signal out_signal_StepValue 3001

signal out_signal_3002 3002
signal out_signal_StepDown 3002

signal out_signal_3003 3003
signal out_signal_StepUp 3003

proc countUp ()
    signal write out_signal_StepUp 1
    wait 100
    signal write out_signal_StepUp 0
    wait 100 
end proc

proc countDown ()
    signal write out_signal_StepDown 1
    wait 100
    signal write out_signal_StepDown 0
    wait 100 
end proc

proc initDut ()
    signal write out_signal_init_dut 1
    wait 100
    signal write out_signal_init_dut 0
    wait 100
end proc

end namespace