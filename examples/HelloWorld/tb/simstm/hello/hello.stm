include "../../../../../lib/base.stm"

namespace HelloWorld

signal out_signal_init_dut 1

signal in_signal_Active 2000

proc testHelloWorld ()
    call stm.startStandardTestShell ()
    loop 3
        log message stm.ALWAYS "Hello World"
        wait 1000
    end loop
    call stm.endStandardTestShell ()
end proc

proc testActivation ()
    call stm.startStandardTestShell ()
    signal write out_signal_init_dut 0
    wait 20
    signal verify in_signal_Active 1 1
    call stm.endStandardTestShell ()
end proc

end namespace