include "Common/Common.stm"
include "TestSuites/TestSuiteCount.stm"

namespace CounterPlain
proc testMainSuiteCount ()
 
    verbosity stm.INFO_2
    trace stm.TRACE_OFF
    resume stm.RESUME_ON_ALL_FAILURES
    signal write out_signal_init_dut 1
    wait 1000
    signal write out_signal_init_dut 0
    signal read stm.sigInTestSuiteIndex stm.TestSuiteIndex
    log message stm.INFO "Main test main suite Count started"

    call testSuiteCount ()

    log message stm.INFO "Main test main suite Count ended"
    wait 1000
    finish
end proc
end namespace
