include "common/common.stm"

namespace CounterSuiteCaseIndexed

    lines success_lines
    file simulation_success "simulation.success"

    proc testMain ()
        log message stm.INFO "Main test started"
       
       
        equ stm.TestSuiteIndex 5
        equ stm.TestCaseIndex 1
        call testCountUp ()
        
        log message stm.INFO "Main test finished"
        wait 1000
        lines append message success_lines "SUCCESS"
        log lines stm.INFO success_lines
        file write simulation_success success_lines
        wait 1000
        finish
    end proc

end namespace