include "../common/common.stm"

namespace CounterSuiteIndexed

proc testCountUp (
    var TestSuiteIndex stm.TestSuiteIndex
)
    var expextedCount 0
    var loadValue stm.TestSuiteIndex
    mul loadValue 5
    and loadValue 256
    
    equ expextedCount loadValue
    
    call stm.startStandardTestShell ()
    call initDut ()    
    signal write sigOutLoadStepValue loadValue
    call countLoad ()
    signal verify sigInCount expextedCount 0xFF
    loop 4
        call countUp ()    
        add expextedCount 1  
        signal verify sigInCount expextedCount 0xFF
        wait 1000
    end loop
    call stm.endStandardTestShell ()
end proc

proc testCountDown (
    var TestSuiteIndex stm.TestSuiteIndex
)
    var expextedCount 0
    var loadValue stm.TestSuiteIndex
    mul loadValue 5
    and loadValue 256
    
    equ expextedCount loadValue
    
    call stm.startStandardTestShell ()
    call initDut ()    
    signal write sigOutLoadStepValue loadValue
    call countLoad ()
    signal verify sigInCount expextedCount 0xFF
    loop 4
        call countDown ()    
        sub expextedCount 1  
        signal verify sigInCount expextedCount 0xFF
        wait 1000
    end loop
    call stm.endStandardTestShell ()
end proc

end namespace